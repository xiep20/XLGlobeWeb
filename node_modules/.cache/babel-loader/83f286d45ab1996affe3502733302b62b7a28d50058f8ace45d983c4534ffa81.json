{"ast":null,"code":"export default {\n  name: 'ZhihuiShuiwu',\n  props: {},\n  data: function data() {\n    return {\n      items_feature: [{\n        id: 1,\n        itemTitle: '透彻感知',\n        itemText: '构建全时水文物联网监测体系，特别是水源地、重要断面，水库等关键区域的传感器与智能设备组成物联网，实时对从监测对象的水位、流量、降水等监测与分析，做到变被动为主动、透彻感知。'\n      }, {\n        id: 2,\n        itemTitle: '广泛互联',\n        itemText: '水文作为防汛抗旱、水环境治理多领域拓展的建设项目，其发展不是孤立的，涉及面必然极为广泛。未来，智慧水文必将与水务管理的其他信息化模块互联对接，按照水利部标准构建水文数据库，以进一步丰富和拓展水文信息化内涵。'\n      }, {\n        id: 3,\n        itemTitle: '智能运作',\n        itemText: '深入结合大数据、水文水动力模型技术，实现从信息采集到分析判断、预警、自适应操作的全程指挥操作，通过数学模型提取有价值的信息，为水文工作提供强大的决策支持，强化武汉市水文工作的科学性和前瞻性。'\n      }],\n      items_application: [{\n        id: 1,\n        imgSrc: require('../../../assets/images/application/zhsw_application1.png')\n      }, {\n        id: 2,\n        imgSrc: require('../../../assets/images/application/zhsw_application2.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items_feature","id","itemTitle","itemText","items_application","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuishuiwu.vue"],"sourcesContent":["<template>\r\n  <div class=\"body\">\r\n    <div class=\"wbk\">\r\n      <div class=\"part\" style=\"padding-bottom:20px\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>智慧水务</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <p>\r\n            公司智慧水利服务平台采用面向服务架构（SOA） 思想，\r\n            以“云计算”、“物联网”等技术为支撑、以水利信息化基础设施整合为先导，以水利信息资源共享为核心，\r\n            以水利业务应用推进为重点， 以标准规范体系为指导，\r\n            以安全防护体系为保障，采用“分布多级、统一管理、集中服务”的总体架构模式，推进水利信息化的全面渗透，深度融合，将水利信息化提高到全新的水平。\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"wbk\">\r\n      <div class=\"part\" style=\"padding-top: 0\">\r\n        <div style=\"width: 349px\"></div>\r\n        <div class=\"mainImg\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>系统特点</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        <ul class=\"right_ul\">\r\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\r\n            <p>{{ item.itemTitle }}</p>\r\n            <p>{{ item.itemText }}</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>应用案例</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"main_text\">\r\n        <p>\r\n          公司结合水利部门职责及业务需求，依托水利云数据中心，针对河湖长制、防汛抗旱、水资源管理、城市供排水管理、水政执法、水利工程建设管理、河湖水域划界确权管理、水库灌区信息化、水利电子政务等方向，建设业务应用系统，通过信息化手段，全面提高管理人员业务能力，规范管理流程，\r\n          提高管理效率。\r\n        </p>\r\n      </div>\r\n      <div class=\"main_application\">\r\n        <ul>\r\n          <li v-for=\"item in items_application\" :key=\"item.id\">\r\n            <div\r\n              class=\"main_applicationImg\"\r\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\r\n            ></div>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiShuiwu',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items_feature: [\r\n        {\r\n          id: 1,\r\n          itemTitle: '透彻感知',\r\n          itemText:\r\n            '构建全时水文物联网监测体系，特别是水源地、重要断面，水库等关键区域的传感器与智能设备组成物联网，实时对从监测对象的水位、流量、降水等监测与分析，做到变被动为主动、透彻感知。',\r\n        },\r\n        {\r\n          id: 2,\r\n          itemTitle: '广泛互联',\r\n          itemText:\r\n            '水文作为防汛抗旱、水环境治理多领域拓展的建设项目，其发展不是孤立的，涉及面必然极为广泛。未来，智慧水文必将与水务管理的其他信息化模块互联对接，按照水利部标准构建水文数据库，以进一步丰富和拓展水文信息化内涵。',\r\n        },\r\n        {\r\n          id: 3,\r\n          itemTitle: '智能运作',\r\n          itemText:\r\n            '深入结合大数据、水文水动力模型技术，实现从信息采集到分析判断、预警、自适应操作的全程指挥操作，通过数学模型提取有价值的信息，为水文工作提供强大的决策支持，强化武汉市水文工作的科学性和前瞻性。',\r\n        },\r\n      ],\r\n      items_application: [\r\n        {\r\n          id: 1,\r\n          imgSrc: require('../../../assets/images/application/zhsw_application1.png'),\r\n        },\r\n        {\r\n          id: 2,\r\n          imgSrc: require('../../../assets/images/application/zhsw_application2.png'),\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.wbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #fff;\r\n}\r\n.gbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #f8f8f8;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  padding: 80px 0;\r\n}\r\n.left_title {\r\n  display: flex;\r\n  margin-right: 90px;\r\n}\r\n.left_title_icon {\r\n  width: 6px;\r\n  height: 36px;\r\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\r\n  margin-top: 8px;\r\n  margin-right: 10px;\r\n}\r\n.left_title_text {\r\n  width: 230px;\r\n  font-size: 38px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: bold;\r\n  color: #333333;\r\n  line-height: 50px;\r\n}\r\n.right_text {\r\n  width: 870px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 300;\r\n  color: #333333;\r\n  line-height: 30px;\r\n}\r\n.mainImg {\r\n  width: 533px;\r\n  height: 638px;\r\n  margin-right: 318px;\r\n  margin-left: -38px;\r\n  background: url('~@/assets/images/application/zhsw_main.png');\r\n}\r\n.right_ul {\r\n  display: flex;\r\n  width: 1200px;\r\n  margin-top: -40px;\r\n  list-style: none;\r\n  padding-bottom: 80px;\r\n  li {\r\n    width: 320px;\r\n    height: 220px;\r\n    padding: 40px;\r\n    p:nth-child(1) {\r\n      position: relative;\r\n      top: 220px;\r\n      bottom: 0px;\r\n      margin: 0 auto;\r\n      font-size: 18px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n    }\r\n    p:nth-child(2) {\r\n      font-size: 14px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: 400;\r\n    }\r\n  }\r\n  li:nth-child(2n) {\r\n    color: #333333;\r\n    background: #ffffff;\r\n  }\r\n  li:nth-child(2n-1) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n}\r\n.main_text {\r\n  width: 1198px;\r\n  margin-top: -40px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 400;\r\n  color: #666666;\r\n  line-height: 28px;\r\n}\r\n.main_application {\r\n  width: 1198px;\r\n  margin-top: 20px;\r\n  margin-bottom: 81px;\r\n  ul {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    list-style: none;\r\n    margin-top: 20px;\r\n    .main_applicationImg {\r\n      height: 287px;\r\n      width: 544px;\r\n      margin-bottom: 9px;\r\n      margin-right: 40px;\r\n      background-size: 100%;\r\n    }\r\n    li:nth-child(2) {\r\n      .main_applicationImg {\r\n        height: 287px;\r\n        width: 614px;\r\n        margin-bottom: 9px;\r\n        margin-right: 0px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AA2EA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,aAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,EACA;MACAC,iBAAA,GACA;QACAH,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}