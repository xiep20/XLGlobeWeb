{"ast":null,"code":"export default {\n  name: 'ZhihuiChengshi',\n  props: {},\n  data: function data() {\n    return {\n      items: [{\n        id: 1,\n        itemTitle: '智慧城市时空信息云平台',\n        itemText: '以北斗时空为基准，以位置服务为核心，通过大数据、物联网、云计算等新一代信息技术，实时汇集城市各种时空信息，形成感知更透彻、互联更广泛、决策更智能、服务更灵活、更加安全可靠的智慧城市时空信息平台，是新型智慧城市建设的重要空间信息基础设施。'\n      }, {\n        id: 2,\n        itemTitle: '时空大数据中心',\n        itemText: '基于北斗卫星导航定位技术建设的综合性高精度位置服务体系，融合大数据、高性能云计算和海量云存储技术，为政府部门、行业用户、大众用户提供基于高精度位置导航、监控、调度和分析决策技术支持服务。'\n      }, {\n        id: 3,\n        itemTitle: '北斗高精度位置服务云平台',\n        itemText: '通过对时空大数据的收集和各种业务系统库的对接，将不同来源、不同类型、不同应用的时空数据进行集中、规范的整合；并通过基础地理信息平台完成数据发布和资源共享，形成智慧城市的“知识库”。'\n      }],\n      items_feature: [{\n        id: 1,\n        title: '智慧城市时空信息云平台',\n        content: '以北斗时空为基准，以位置服务为核心，通过大数据、物联网、云计算等新一代信息技术，实时汇集城市各种时空信息，形成感知更透彻、互联更广泛、决策更智能、服务更灵活、更加安全可靠的智慧城市时空信息平台，是新型智慧城市建设的重要空间信息基础设施。'\n      }, {\n        id: 2,\n        title: '时空大数据中心',\n        content: '基于北斗卫星导航定位技术建设的综合性高精度位置服务体系，融合大数据、高性能云计算和海量云存储技术，为政府部门、行业用户、大众用户提供基于高精度位置导航、监控、调度和分析决策技术支持服务。'\n      }, {\n        id: 3,\n        title: '北斗高精度位置服务云平台',\n        content: '通过对时空大数据的收集和各种业务系统库的对接，将不同来源、不同类型、不同应用的时空数据进行集中、规范的整合；并通过基础地理信息平台完成数据发布和资源共享，形成智慧城市的“知识库”。'\n      }],\n      items_application: [{\n        id: 1,\n        imgSrc: require('@/assets/images/application/zhcs_application1.png')\n      }, {\n        id: 2,\n        imgSrc: require('../../../assets/images/application/zhcs_application2.png')\n      }, {\n        id: 3,\n        imgSrc: require('../../../assets/images/application/zhcs_application3.png')\n      }, {\n        id: 4,\n        imgSrc: require('../../../assets/images/application/zhcs_application4.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items","id","itemTitle","itemText","items_feature","title","content","items_application","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuichengshi.vue"],"sourcesContent":["<template>\n  <div class=\"body\">\n    <div class=\"wbk\">\n      <div class=\"part\" style=\"padding-bottom: 20px\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>新型智慧城市</p>\n          </div>\n        </div>\n        <div class=\"right_text\">\n          <p>\n            公司以城市多元化、多时态信息为基础，在原有城市的基础设施上，通过建设智慧城市时空信息云平台、北斗高精度位置服务云平台、大数据中心三大基础设施，将各类数据互联互通，为新型智慧城市提供精准、高效的时空位置服务，真正的实现大数据时代城市有“信息烟囱”(\n            信息孤岛)向“信息连通器”( 信息互享互通)转变。\n          </p>\n        </div>\n      </div>\n    </div>\n    <div class=\"wbk\">\n      <div class=\"part\" style=\"padding-top: 0\">\n        <div style=\"width: 349px\"></div>\n        <div class=\"mainImg\"></div>\n      </div>\n    </div>\n\n    <div class=\"gbk\">\n      <div class=\"part\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>系统特点</p>\n          </div>\n        </div>\n      </div>\n      <div>\n        <ul class=\"right_ul\">\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\n            <p>{{ item.title }}</p>\n            <p>{{ item.content }}</p>\n          </li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"wbk\">\n      <div class=\"part\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>应用案例</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"main_text\">\n        <p>\n          德毅智慧三区联动综合监管平台以整合大学资源为主线，就地拓展、就近发展，实现大学校区、科技园区、公共社区融合联动。校区主要为园区提供创新创业人才和项目，为光谷高新技术开发区的经济与社会发展提供智力支持;园区是大学师生、科研人员和城区居民创新创业及就业的场所，是城区经济发展的一个增长极;社区主要为校区和园区提供公共服务，以创造一一个适宜居注休闲、交的环境。\n        </p>\n      </div>\n      <div class=\"main_application\">\n        <ul>\n          <li v-for=\"item in items_application\" :key=\"item.id\">\n            <div\n              class=\"main_applicationImg\"\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\n            ></div>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  name: 'ZhihuiChengshi',\n  props: {},\n  data() {\n    return {\n      items: [\n        {\n          id: 1,\n          itemTitle: '智慧城市时空信息云平台',\n          itemText:\n            '以北斗时空为基准，以位置服务为核心，通过大数据、物联网、云计算等新一代信息技术，实时汇集城市各种时空信息，形成感知更透彻、互联更广泛、决策更智能、服务更灵活、更加安全可靠的智慧城市时空信息平台，是新型智慧城市建设的重要空间信息基础设施。',\n        },\n        {\n          id: 2,\n          itemTitle: '时空大数据中心',\n          itemText:\n            '基于北斗卫星导航定位技术建设的综合性高精度位置服务体系，融合大数据、高性能云计算和海量云存储技术，为政府部门、行业用户、大众用户提供基于高精度位置导航、监控、调度和分析决策技术支持服务。',\n        },\n        {\n          id: 3,\n          itemTitle: '北斗高精度位置服务云平台',\n          itemText:\n            '通过对时空大数据的收集和各种业务系统库的对接，将不同来源、不同类型、不同应用的时空数据进行集中、规范的整合；并通过基础地理信息平台完成数据发布和资源共享，形成智慧城市的“知识库”。',\n        },\n      ],\n      items_feature: [\n        {\n          id: 1,\n          title: '智慧城市时空信息云平台',\n          content:\n            '以北斗时空为基准，以位置服务为核心，通过大数据、物联网、云计算等新一代信息技术，实时汇集城市各种时空信息，形成感知更透彻、互联更广泛、决策更智能、服务更灵活、更加安全可靠的智慧城市时空信息平台，是新型智慧城市建设的重要空间信息基础设施。',\n        },\n        {\n          id: 2,\n          title: '时空大数据中心',\n          content:\n            '基于北斗卫星导航定位技术建设的综合性高精度位置服务体系，融合大数据、高性能云计算和海量云存储技术，为政府部门、行业用户、大众用户提供基于高精度位置导航、监控、调度和分析决策技术支持服务。',\n        },\n        {\n          id: 3,\n          title: '北斗高精度位置服务云平台',\n          content:\n            '通过对时空大数据的收集和各种业务系统库的对接，将不同来源、不同类型、不同应用的时空数据进行集中、规范的整合；并通过基础地理信息平台完成数据发布和资源共享，形成智慧城市的“知识库”。',\n        },\n      ],\n      items_application: [\n        {\n          id: 1,\n          imgSrc: require('@/assets/images/application/zhcs_application1.png'),\n        },\n        {\n          id: 2,\n          imgSrc: require('../../../assets/images/application/zhcs_application2.png'),\n        },\n        {\n          id: 3,\n          imgSrc: require('../../../assets/images/application/zhcs_application3.png'),\n        },\n        {\n          id: 4,\n          imgSrc: require('../../../assets/images/application/zhcs_application4.png'),\n        },\n      ],\n    }\n  },\n  watch: {},\n  mounted() {},\n  methods: {},\n}\n</script>\n<style lang=\"less\" scoped>\n.wbk {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  background: #fff;\n}\n.gbk {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  background: #f8f8f8;\n}\n.part {\n  display: flex;\n  width: 1200px;\n  padding: 80px 0;\n}\n.left_title {\n  display: flex;\n  margin-right: 90px;\n}\n.left_title_icon {\n  width: 6px;\n  height: 36px;\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\n  margin-top: 8px;\n  margin-right: 10px;\n}\n.left_title_text {\n  width: 230px;\n  font-size: 38px;\n  font-family: Microsoft YaHei;\n  font-weight: bold;\n  color: #333333;\n  line-height: 50px;\n}\n.right_text {\n  width: 870px;\n  font-size: 14px;\n  font-family: Microsoft YaHei;\n  font-weight: 300;\n  color: #333333;\n  line-height: 30px;\n}\n.mainImg {\n  width: 780px;\n  height: 830px;\n  margin-left: -15px;\n  background: url('~@/assets/images/application/zhcs_main.png');\n}\n.right_ul {\n  display: flex;\n  width: 1200px;\n  margin-top: -40px;\n  list-style: none;\n  padding-bottom: 80px;\n  li {\n    width: 307px;\n    height: 260px;\n    padding: 40px 50px 0 43px;\n    p:nth-child(1) {\n      position: relative;\n      top: 217px;\n      bottom: 0px;\n      font-size: 18px;\n      font-family: Microsoft YaHei;\n      font-weight: bold;\n    }\n    p:nth-child(2) {\n      margin-top: -18px;\n      font-size: 14px;\n      font-family: Microsoft YaHei;\n      font-weight: 400;\n    }\n  }\n  li:nth-child(2) {\n    height: 264px;\n    width: 320px;\n    padding: 36px 37px 0 43px;\n  }\n  li:nth-child(3) {\n    height: 262px;\n    width: 303px;\n    padding: 36px 37px 0 43px;\n  }\n  li:nth-child(2n) {\n    color: #333333;\n    background: #ffffff;\n  }\n  li:nth-child(2n-1) {\n    color: #ffffff;\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\n  }\n}\n.main_text {\n  width: 1198px;\n  margin-top: -40px;\n  font-size: 14px;\n  font-family: Microsoft YaHei;\n  font-weight: 400;\n  color: #666666;\n  line-height: 28px;\n}\n.main_application {\n  width: 1198px;\n  margin-top: 20px;\n  margin-bottom: 81px;\n  ul {\n    display: flex;\n    flex-wrap: wrap;\n    list-style: none;\n    .main_applicationImg {\n      height: 300px;\n      width: 590px;\n      margin-bottom: 9px;\n      margin-right: 9px;\n      background-size: 100%;\n    }\n  }\n}\n</style>\n"],"mappings":"AAwEA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,EACA;MACAC,aAAA,GACA;QACAH,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAL,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAL,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,EACA;MACAC,iBAAA,GACA;QACAN,EAAA;QACAO,MAAA,EAAAC,OAAA;MACA,GACA;QACAR,EAAA;QACAO,MAAA,EAAAC,OAAA;MACA,GACA;QACAR,EAAA;QACAO,MAAA,EAAAC,OAAA;MACA,GACA;QACAR,EAAA;QACAO,MAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}