{"ast":null,"code":"import '../../themes/scroll.less';\nimport ExampleList from './ExampleList';\nimport LyFoot from '../../layout/LyFoot2';\nexport default {\n  name: 'ExamplesIndex',\n  components: {\n    ExampleList: ExampleList,\n    LyFoot: LyFoot\n  },\n  data: function data() {\n    return {\n      examplesData: [],\n      divHeightArray: [],\n      //所有右侧小块的高度\n      currentMenuTxt: [],\n      //所有右侧小块的名称\n      currentMenu: [0, 0],\n      //当前选中的菜单数组\n      current: 'online' //选中的名称\n    };\n  },\n  methods: {\n    handleScroll: function handleScroll() {\n      var _this2 = this;\n      // let scrollbarEl = this.$refs.content.wrap\n      var scrollbarEl = this.$refs.content;\n      scrollbarEl.onscroll = function () {\n        //监听滚动事件\n        _this2.divHeightArray.forEach(function (item, index) {\n          item.filter(function (it, i) {\n            if (it < scrollbarEl.scrollTop + 100) {\n              _this2.currentMenu = [index, i]; //当前滑动选择的菜单\n            }\n          });\n        });\n        if (_this2.$refs.leftSiderBar.sidebarToggleFlag) {\n          _this2.current = _this2.currentMenuTxt[_this2.currentMenu[0]][_this2.currentMenu[1]]; //从文字数组中提出中文\n        }\n      };\n    },\n    getExamplesData: function getExamplesData() {\n      var _this3 = this;\n      var _this = this;\n      if (this.$http && typeof this.$http.get === 'function') {\n        this.$http.get('config/examples.json').then(function (res) {\n          _this3.examplesData = res.data || [];\n          if (res.data) {\n            setTimeout(function () {\n              res.data.forEach(function (item, index) {\n                _this.divHeightArray[index] = new Array(); //高度数组集合\n                _this.currentMenuTxt[index] = new Array(); //文字数组集合\n                item.children.forEach(function (obj, i) {\n                  _this.divHeightArray[index][i] = _this.$refs.examplesDataRef.$refs[obj.name][0].offsetTop; //获取高度\n                  _this.currentMenuTxt[index][i] = obj.name;\n                });\n              });\n            }, 2000);\n          }\n        })[\"catch\"](function (error) {\n          console.error('Failed to load examples data:', error);\n        });\n      } else {\n        console.error('$http not available in getExamplesData');\n      }\n    },\n    selectMenuHandler: function selectMenuHandler(value) {\n      if (value) {\n        var el = document.getElementById('nav-' + value);\n        if (el) {\n          this.$refs['content'].scrollTop = el.offsetTop - 15;\n          // this.$refs['content'].wrap.scrollTop = el.offsetTop - 15\n        }\n      }\n    }\n  },\n  mounted: function mounted() {\n    var _this4 = this;\n    this.$nextTick(function () {\n      _this4.getExamplesData();\n      _this4.handleScroll();\n    });\n  },\n  created: function created() {}\n};","map":{"version":3,"names":["ExampleList","LyFoot","name","components","data","examplesData","divHeightArray","currentMenuTxt","currentMenu","current","methods","handleScroll","_this2","scrollbarEl","$refs","content","onscroll","forEach","item","index","filter","it","i","scrollTop","leftSiderBar","sidebarToggleFlag","getExamplesData","_this3","_this","$http","get","then","res","setTimeout","Array","children","obj","examplesDataRef","offsetTop","error","console","selectMenuHandler","value","el","document","getElementById","mounted","_this4","$nextTick","created"],"sources":["src/views/examples/index.vue"],"sourcesContent":["<template>\n  <div class=\"examples\">\n    <el-row class=\"row\">\n      <el-col style=\"width:300px;\" class=\"hidden-md-and-down menu\">\n        <sider-bar\n          ref=\"leftSiderBar\"\n          :menu-data=\"examplesData\"\n          :default-active=\"current\"\n          @on-menu-select=\"selectMenuHandler\"\n        ></sider-bar>\n      </el-col>\n      <el-col style=\"width: calc(100% - 303px);height: calc(100% - 60px);\" class=\"col menuright\">\n        <div class=\"content mscroll\" ref=\"content\" >\n        <!-- <el-scrollbar ref=\"contents\" style=\"height:100%;overflow-x:hidden;\"> -->\n          <div class=\"tips\">\n            <span>说明：</span>\n            <p>1.示例仅做参考，展现的数据只是测试数据。</p>\n            <p>2.示例使用XLGlobe开发。</p>\n            <p>\n              3.如果需要额外的示例或者示例存在的问题，请联系&nbsp;<a\n                href=\"#\"\n                >我</a\n              >。\n            </p>\n          </div>\n          <el-popover placement=\"top-start\" trigger=\"click\">\n            <sider-bar\n              :menu-data=\"examplesData\"\n              :show-children=\"false\"\n              class=\"nav-menu\"\n              @on-menu-select=\"selectMenuHandler\"\n            ></sider-bar>\n            <img\n              slot=\"reference\"\n              src=\"@/assets/svg/bg/nav.svg\"\n              class=\"nav-icon hidden-md-and-up\"\n            />\n          </el-popover>\n          <example-list id=\"scroll\" :examples-data=\"examplesData\" ref=\"examplesDataRef\"></example-list>\n        <!-- </el-scrollbar> -->\n          <ly-foot></ly-foot>\n        </div>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n<script>\nimport '../../themes/scroll.less'\nimport ExampleList from './ExampleList'\nimport LyFoot from '../../layout/LyFoot2'\nexport default {\n  name: 'ExamplesIndex',\n  components: {\n    ExampleList,\n    LyFoot,\n  },\n  data() {\n    return {\n      examplesData: [],\n      divHeightArray: [],//所有右侧小块的高度\n      currentMenuTxt: [],//所有右侧小块的名称\n      currentMenu: [0,0],//当前选中的菜单数组\n      current: 'online',//选中的名称\n    }\n  },\n  methods: {\n    handleScroll() {\n      // let scrollbarEl = this.$refs.content.wrap\n      let scrollbarEl = this.$refs.content\n      scrollbarEl.onscroll = () => {//监听滚动事件\n        this.divHeightArray.forEach((item,index)=>{\n          item.filter((it,i)=>{\n            if(it < (scrollbarEl.scrollTop + 100)){\n              this.currentMenu = [index,i]//当前滑动选择的菜单\n            }\n          })\n        })\n        if(this.$refs.leftSiderBar.sidebarToggleFlag){\n          this.current = this.currentMenuTxt[this.currentMenu[0]][this.currentMenu[1]]//从文字数组中提出中文\n        }\n      }\n    },\n    getExamplesData() {\n      let _this = this;\n      if (this.$http && typeof this.$http.get === 'function') {\n        this.$http.get('config/examples.json').then((res) => {\n          this.examplesData = res.data || []\n          if(res.data){\n            setTimeout(() => {\n              res.data.forEach((item,index) => {\n                _this.divHeightArray[index] = new Array();//高度数组集合\n                _this.currentMenuTxt[index] = new Array();//文字数组集合\n                item.children.forEach((obj,i)=>{\n                  _this.divHeightArray[index][i] = _this.$refs.examplesDataRef.$refs[obj.name][0].offsetTop//获取高度\n                  _this.currentMenuTxt[index][i] = obj.name\n                })\n              });\n            }, 2000);\n          }\n        }).catch((error) => {\n          console.error('Failed to load examples data:', error)\n        })\n      } else {\n        console.error('$http not available in getExamplesData')\n      }\n    },\n    selectMenuHandler(value) {\n      if (value) {\n        let el = document.getElementById('nav-' + value)\n        if (el) {\n          this.$refs['content'].scrollTop = el.offsetTop - 15\n          // this.$refs['content'].wrap.scrollTop = el.offsetTop - 15\n        }\n      }\n    },\n  },\n  mounted() {\n    this.$nextTick(() => {\n      this.getExamplesData()\n      this.handleScroll()\n    })\n  },\n  created(){\n    \n  }\n}\n</script>\n\n<style lang=\"scss\">\n.nav-menu {\n  .el-menu-item {\n    color: rgba(0, 0, 0, 0.6);\n    font-weight: bold;\n    height: 40px;\n    line-height: 40px;\n    .icon-svg {\n      color: rgba(0, 0, 0, 0.6);\n    }\n  }\n}\n</style>\n\n<style lang=\"scss\" scoped>\n\n.examples {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  padding-top: 60px;\n  .row,\n  .col {\n    // height: calc(100% - 32px);\n    height: 100%;\n  }\n  .menu {\n    // background: rgba(1, 13, 30, 0.9);\n    // background: linear-gradient(to bottom, #010308, #041e52, #010205);\n    background: linear-gradient(to bottom, #010308, #051a46, #041d4f);\n    height: 100%;\n    // padding-top: 20px;\n    // padding-left: 10px;\n    overflow: hidden;\n    margin-top: 1px;\n    border-top-right-radius: 2px;\n    border-bottom-right-radius: 2px;\n    transition: 0.5s;\n  }\n  .menuright {\n    width: 87%;\n    float: right;\n    transition: width 0.5s;\n    background-color: #efefef;\n  }\n  .content {\n    height: 100%;\n    padding: 10px 20px 0px 20px;\n    overflow: hidden;\n    overflow-y: auto;\n    .tips {\n      font-size: 13px;\n      color: rgba(0, 0, 0, 0.6);\n      margin-bottom: 10px;\n      p {\n        padding-top: 5px;\n      }\n      a {\n        text-decoration: none;\n        color: #0865ba;\n      }\n    }\n  }\n\n  .nav-icon {\n    position: absolute;\n    left: 10px;\n    bottom: 10px;\n    width: 30px;\n    height: 30px;\n    cursor: pointer;\n  }\n}\n::v-deep .el-scrollbar__wrap{\n  overflow-x: hidden !important;\n}\n// ::v-deep .el-scrollbar__bar{\n//   &.is-vertical{\n//     width:0;//滚动条宽度\n//   }\n// }\n</style>\n"],"mappings":"AA+CA;AACA,OAAAA,WAAA;AACA,OAAAC,MAAA;AACA;EACAC,IAAA;EACAC,UAAA;IACAH,WAAA,EAAAA,WAAA;IACAC,MAAA,EAAAA;EACA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,YAAA;MACAC,cAAA;MAAA;MACAC,cAAA;MAAA;MACAC,WAAA;MAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,YAAA,WAAAA,aAAA;MAAA,IAAAC,MAAA;MACA;MACA,IAAAC,WAAA,QAAAC,KAAA,CAAAC,OAAA;MACAF,WAAA,CAAAG,QAAA;QAAA;QACAJ,MAAA,CAAAN,cAAA,CAAAW,OAAA,WAAAC,IAAA,EAAAC,KAAA;UACAD,IAAA,CAAAE,MAAA,WAAAC,EAAA,EAAAC,CAAA;YACA,IAAAD,EAAA,GAAAR,WAAA,CAAAU,SAAA;cACAX,MAAA,CAAAJ,WAAA,IAAAW,KAAA,EAAAG,CAAA;YACA;UACA;QACA;QACA,IAAAV,MAAA,CAAAE,KAAA,CAAAU,YAAA,CAAAC,iBAAA;UACAb,MAAA,CAAAH,OAAA,GAAAG,MAAA,CAAAL,cAAA,CAAAK,MAAA,CAAAJ,WAAA,KAAAI,MAAA,CAAAJ,WAAA;QACA;MACA;IACA;IACAkB,eAAA,WAAAA,gBAAA;MAAA,IAAAC,MAAA;MACA,IAAAC,KAAA;MACA,SAAAC,KAAA,gBA