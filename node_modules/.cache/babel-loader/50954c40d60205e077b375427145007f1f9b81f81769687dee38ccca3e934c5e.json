{"ast":null,"code":"export default {\n  name: 'ZhihuiYuanqu',\n  props: {},\n  data: function data() {\n    return {\n      items_feature: [{\n        id: 1,\n        itemTitle: '三维可视化管理',\n        itemText: '利用三维建模及可视化技术，实现园区三维可视化管理。'\n      }, {\n        id: 2,\n        itemTitle: '智能巡检',\n        itemText: '基于”一张图”，对危险源隐患进行查询、统计实现隐患点及巡查轨迹的采集上报。'\n      }, {\n        id: 3,\n        itemTitle: '访客指引',\n        itemText: '基于园区数字化地图，对访客进行最短路径或最短时间分析，提供实时路径的精准指引。'\n      }, {\n        id: 4,\n        itemTitle: '人员可视',\n        itemText: '建立人员画像，包括 个人基本信息，工作技能，工作状态，移动轨迹，实时位置信息等。'\n      }, {\n        id: 5,\n        itemTitle: '安防监控',\n        itemText: '实现园区大范围全景监控，并对各个监控点视频数据接口进行调用。'\n      }, {\n        id: 6,\n        itemTitle: '资源可视',\n        itemText: '建立设施画像，包括设备详情，生命周期，关联关系，配置参数，运行状态，移动轨迹，位置等。'\n      }, {\n        id: 7,\n        itemTitle: '事件可视',\n        itemText: '建立事件信息画像，包括事件名称，事件地点、事件状态、事件级别、事件参数等。'\n      }, {\n        id: 8,\n        itemTitle: '智能停车',\n        itemText: '将车位余量显示、车位动态识别，车卡合一，将费用查询和支付等功能接入园区微信或APP，实现无需停留，视频识别，无卡支付。'\n      }],\n      items_application: [{\n        id: 1,\n        imgSrc: require('../../../assets/images/application/zhyq_application1.png')\n      }, {\n        id: 2,\n        imgSrc: require('../../../assets/images/application/zhyq_application2.png')\n      }, {\n        id: 3,\n        imgSrc: require('../../../assets/images/application/zhyq_application3.png')\n      }, {\n        id: 4,\n        imgSrc: require('../../../assets/images/application/zhyq_application4.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items_feature","id","itemTitle","itemText","items_application","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuiyuanqu.vue"],"sourcesContent":["<template>\r\n  <div class=\"body\">\r\n    <div class=\"wbk\">\r\n      <div class=\"part\" style=\"padding-bottom: 20px\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>智慧园区</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <p>\r\n            智慧园区是以互联网为载体，融合“互联网+产业”模式，面向园区提供全产业链支撑服务的智慧解决方案。公司利用物联网、大数据、云计算、移动互联网等关键技术，综合多种传感器技术，包括射频识别（RFID）、视频识别（VFID）、GNSS、称重、车辆感应，温/湿度传感、视频监控等，集成各个业务系统，提供包含三维可视化管理，访客指引、智能停车、智能巡检，安防监控等服务在内的智慧园区整体解决方案，全面提高园区的管理效率和综合服务水平。\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\" style=\"padding-top: 0px; padding-bottom: 10px\">\r\n        <div style=\"width: 336px\"></div>\r\n        <div class=\"mainImg\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>系统特点</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        <ul class=\"right_ul\">\r\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\r\n            <p>{{ item.itemTitle }}</p>\r\n            <p>{{ item.itemText }}</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>应用案例</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"main_text\">\r\n        <p>\r\n          智慧园区综合管理平台系统以视频业务为核心，接入园区弱电安防应用子系统，形成园区管控一体化综合解决方案，并且通过内业务子系统的自由灵活组合，进行数据提取分析应用，从而对园区的人员、车辆、物资实行全方位、多业务的融合智能方式综合管理、业务优化，提升园区管理效率、优化业务流程，并可形成多个细分解决方案应用，以满足不同的园区场景需求应用。\r\n        </p>\r\n      </div>\r\n      <div class=\"main_application\">\r\n        <ul>\r\n          <li v-for=\"item in items_application\" :key=\"item.id\">\r\n            <div\r\n              class=\"main_applicationImg\"\r\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\r\n            ></div>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiYuanqu',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items_feature: [\r\n        {\r\n          id: 1,\r\n          itemTitle: '三维可视化管理',\r\n          itemText: '利用三维建模及可视化技术，实现园区三维可视化管理。',\r\n        },\r\n        {\r\n          id: 2,\r\n          itemTitle: '智能巡检',\r\n          itemText:\r\n            '基于”一张图”，对危险源隐患进行查询、统计实现隐患点及巡查轨迹的采集上报。',\r\n        },\r\n        {\r\n          id: 3,\r\n          itemTitle: '访客指引',\r\n          itemText:\r\n            '基于园区数字化地图，对访客进行最短路径或最短时间分析，提供实时路径的精准指引。',\r\n        },\r\n        {\r\n          id: 4,\r\n          itemTitle: '人员可视',\r\n          itemText:\r\n            '建立人员画像，包括 个人基本信息，工作技能，工作状态，移动轨迹，实时位置信息等。',\r\n        },\r\n        {\r\n          id: 5,\r\n          itemTitle: '安防监控',\r\n          itemText:\r\n            '实现园区大范围全景监控，并对各个监控点视频数据接口进行调用。',\r\n        },\r\n        {\r\n          id: 6,\r\n          itemTitle: '资源可视',\r\n          itemText:\r\n            '建立设施画像，包括设备详情，生命周期，关联关系，配置参数，运行状态，移动轨迹，位置等。',\r\n        },\r\n        {\r\n          id: 7,\r\n          itemTitle: '事件可视',\r\n          itemText:\r\n            '建立事件信息画像，包括事件名称，事件地点、事件状态、事件级别、事件参数等。',\r\n        },\r\n        {\r\n          id: 8,\r\n          itemTitle: '智能停车',\r\n          itemText:\r\n            '将车位余量显示、车位动态识别，车卡合一，将费用查询和支付等功能接入园区微信或APP，实现无需停留，视频识别，无卡支付。',\r\n        },\r\n      ],\r\n      items_application: [\r\n        {\r\n          id: 1,\r\n          imgSrc: require('../../../assets/images/application/zhyq_application1.png'),\r\n        },\r\n        {\r\n          id: 2,\r\n          imgSrc: require('../../../assets/images/application/zhyq_application2.png'),\r\n        },\r\n        {\r\n          id: 3,\r\n          imgSrc: require('../../../assets/images/application/zhyq_application3.png'),\r\n        },\r\n        {\r\n          id: 4,\r\n          imgSrc: require('../../../assets/images/application/zhyq_application4.png'),\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.wbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #fff;\r\n}\r\n.gbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #f8f8f8;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  padding: 80px 0;\r\n}\r\n.left_title {\r\n  display: flex;\r\n  margin-right: 90px;\r\n}\r\n.left_title_icon {\r\n  width: 6px;\r\n  height: 36px;\r\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\r\n  margin-top: 8px;\r\n  margin-right: 10px;\r\n}\r\n.left_title_text {\r\n  width: 230px;\r\n  font-size: 38px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: bold;\r\n  color: #333333;\r\n  line-height: 50px;\r\n}\r\n.right_text {\r\n  width: 870px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 300;\r\n  color: #333333;\r\n  line-height: 30px;\r\n}\r\n.mainImg {\r\n  width: 864px;\r\n  height: 494px;\r\n  margin-left: -2px;\r\n  background: url('~@/assets/images/application/zhyq_main.png') no-repeat;\r\n  background-size: 100%;\r\n}\r\n.right_ul {\r\n  display: flex;\r\n  width: 1200px;\r\n  margin-top: -40px;\r\n  list-style: none;\r\n  padding-bottom: 80px;\r\n  li {\r\n    width: 400px;\r\n    height: 280px;\r\n    padding: 10px;\r\n    p:nth-child(1) {\r\n      position: relative;\r\n      top: 250px;\r\n      bottom: 0px;\r\n      margin: 0 auto;\r\n      font-size: 18px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n    }\r\n    p:nth-child(2) {\r\n      font-size: 14px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: 400;\r\n    }\r\n  }\r\n  li:nth-child(2n) {\r\n    color: #333333;\r\n    background: #ffffff;\r\n  }\r\n  li:nth-child(2n-1) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n}\r\n.main_text {\r\n  width: 1198px;\r\n  margin-top: -40px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 400;\r\n  color: #666666;\r\n  line-height: 28px;\r\n}\r\n.main_application {\r\n  width: 1198px;\r\n  margin-top: 20px;\r\n  margin-bottom: 81px;\r\n  ul {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    list-style: none;\r\n    li:nth-child(1) {\r\n      .main_applicationImg {\r\n        height: 181px;\r\n        width: 371px;\r\n        margin-right: 42px;\r\n      }\r\n    }\r\n    li:nth-child(2) {\r\n      .main_applicationImg {\r\n        height: 181px;\r\n        width: 371px;\r\n        margin-right: 42px;\r\n      }\r\n    }\r\n    li:nth-child(3) {\r\n      .main_applicationImg {\r\n        height: 181px;\r\n        width: 371px;\r\n      }\r\n    }\r\n    li:nth-child(4) {\r\n      .main_applicationImg {\r\n        height: 421px;\r\n        width: 1200px;\r\n        margin-top: 54px;\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAwEA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,aAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,EACA;MACAC,iBAAA,GACA;QACAH,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}