{"ast":null,"code":"export default {\n  name: 'ZhihuiBeidou',\n  props: {},\n  data: function data() {\n    return {\n      items: [{\n        id: 1,\n        title: '高精度定位',\n        content: '全天24小时定位，高精度定位。',\n        src: require('@/assets/images/item/beidou/1.png')\n      }, {\n        id: 2,\n        title: '路线查询',\n        content: '通过轨迹查询，路线回放。',\n        src: require('@/assets/images/item/beidou/5.png')\n      }, {\n        id: 3,\n        title: '全程过程管理',\n        content: '人车工作状态动态管理。',\n        src: require('@/assets/images/item/beidou/2.png')\n      }, {\n        id: 4,\n        title: '行程管理',\n        content: '实时了解人员位置。',\n        src: require('@/assets/images/item/beidou/6.png')\n      }, {\n        id: 5,\n        title: '安全管理',\n        content: '通过全程位置监控，控制安全。',\n        src: require('../../../assets/images/item/beidou/3.png')\n      }, {\n        id: 6,\n        title: '指挥调度',\n        content: '针对生产目标，应急事件优化。',\n        src: require('../../../assets/images/item/beidou/4.png')\n      }, {\n        id: 7,\n        title: '区域报警',\n        content: '超出规定范围，立即报警。',\n        src: require('../../../assets/images/item/beidou/7.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items","id","title","content","src","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuibeidou.vue"],"sourcesContent":["<!--\r\n * @Descripttion : \r\n * @version      : \r\n * @Author       : HeDa\r\n * @Date         : 2021-02-01 11:46:16\r\n * @LastEditors  : HeDa\r\n * @LastEditTime : 2021-02-03 15:31:39\r\n * @FilePath     : /XLGlobeWebV2.0/src/views/application/item/Zhihuibeidou.vue\r\n-->\r\n<template>\r\n  <div class=\"body\">\r\n    <div class=\"tbk\">\r\n      <div class=\"bk\">\r\n        <div class=\"part\">\r\n          <div class=\"part_title\">\r\n            <div class=\"part_title_bar\"></div>\r\n            <p class=\"part_title_text\">\r\n              北斗高精度<br />\r\n              人车物精益化管理\r\n            </p>\r\n          </div>\r\n          <div class=\"part_text\">\r\n            <p>\r\n              随着车载导航定位、移动位置服务、互联网地图等服务的广泛使用，北斗高精度卫星导航及位置服务已经成为经济与社会发展的重要支撑，各行业智能管理与保障体系对高精度导航及位置服务的需求也越来越迫切。通过对人员、车辆或物资设备的资源优化配置，能够成倍提高数据的有效性及可用性，满足信息化服务的多样化需求。\r\n              <br />\r\n              <br />\r\n              公司以空间地理信息资源为基础，综合运用北斗高精度卫星导航定位、物联网、大数据分析处理等技术，通过对各类人员、车辆或物资设备的高精度位置应用，实现生产流程的全过程精益化管理，促进管理、运营效率与经济效益的大幅提升。\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\" style=\"padding-bottom: 0px\">\r\n      <div class=\"part\">\r\n        <div class=\"left_text\">\r\n          <p>功能特色</p>\r\n          <p>\r\n            以生产监控、运营调度和综合业务信息管理为主线，以人车物为对象，通过北斗高精度卫星导航定位系统获取全天候、大范围、高精度的位置信息，为人车物的导航定位、监控管理、指挥调度、安全保密、路径优化提供强有力保障，对生产运营、人力资源、车辆资源、物资资源、信息流进行有效管控，实现人车物全过程的精益化管理。北斗智能定位终端基于北斗高精度定位，根据各类应用的需求，结合其他传感手段，服务于各类行业应用。公司依托成熟的北斗高精度应用技术，提供多平台多功能的北斗高精度服务软件，满足各种业务场景下的应用需求。\r\n          </p>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <ul>\r\n            <li v-for=\"item in items\" :key=\"item.id\">\r\n              <div\r\n                class=\"right_text_li_icon\"\r\n                :style=\"'background:url(' + item.src + ')'\"\r\n              ></div>\r\n              <div class=\"right_text_li_text\">\r\n                <p>{{ item.title }}</p>\r\n                <p>{{ item.content }}</p>\r\n              </div>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\" style=\"padding-bottom: 0px\">\r\n      <div class=\"part\">\r\n        <div class=\"main\">\r\n          <p>应用场景</p>\r\n          <div class=\"main_img\"></div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\">\r\n      <div class=\"part\" style=\"padding-bottom: 0px\">\r\n        <div class=\"application_left\">\r\n          <p>案例与荣誉</p>\r\n          <p>\r\n            公司“基于北斗高精度位置服务的电网资源信息更新关键技术研究与应用”项目荣获“2017年卫星导航定位优秀工程和产品奖特等奖”。\r\n          </p>\r\n          <br />\r\n          <p>\r\n            项目解决了电网资源信息更新业务中存在的诸多问题，打造“一终端、一基准、两体系、全闭环”全套解决方案，率先在国内开展北斗精准服务网电力专网示范工程建设，建立了内外业一体化信息更新体系，打造全方位信息安全防护体系和全闭环管理机制，为电网资源信息更新提供精益化管理手段、提升自动化水平、提高作业效率，有效降低人工成本。\r\n          </p>\r\n        </div>\r\n        <div class=\"application_right\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"tbk\">\r\n      <div class=\"bk\">\r\n        <div class=\"part\">\r\n          <div class=\"part_title\">\r\n            <div class=\"part_title_bar\"></div>\r\n            <p class=\"part_title_text\">形变监测</p>\r\n          </div>\r\n          <div class=\"part_text\">\r\n            <p>\r\n              德毅智慧®北斗/GNSS形变监测解决方案拥有核心北斗解算模块，依托丰富的北斗/GNSS误差模型，集成北斗/GNSS接收机、北斗/GNSS接收机天线阵列、传感监测设备、形变监测分析处理软件、数据库管理平台、TCP/IP网络传输、多线程任务管理系统等，为广大用户提供可靠稳定的北斗/GNSS多模多频板卡等核心部件、GNSS核心解算系统软件以及全方位、高精度、多领域系统集成行业应用解决方案，实现7x24小时多方位立体监控建筑结构和地质形变，为分析变形趋势提供有效数据依据，智能预警，排除隐患，及时预防突如其来的灾害事件。\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_text\" style=\"width: 50%\">\r\n          <p>系统组成</p>\r\n          <p>\r\n            高精度实时形变监测系统集成了北斗/GNSS接收机、风速风向计等多种传感器，由综合管理系统、数据采集系统、数据通讯系统、数据处理系统、分析预警系统组成，实现对桥梁、大坝、电力杆塔、公路边坡、尾矿库、采空区沉降以及路基沉降等建筑结构及地质的高精度三维形变监测。\r\n          </p>\r\n        </div>\r\n        <div class=\"content_right_img\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"tbk\">\r\n      <div class=\"bk\">\r\n        <div class=\"part\">\r\n          <div class=\"part_title\">\r\n            <div class=\"part_title_bar\"></div>\r\n            <p class=\"part_title_text\">精准农业</p>\r\n          </div>\r\n          <div class=\"part_text\">\r\n            <p>\r\n              公司立足我国农业发展现状，致力为广大农业生产者提供一整套优质先进的精准农业解决方案，自主研发的北斗农机自动导航驾驶系统，利用全球卫星导航技术和自动化技术，通过高精度导航终端和北斗农业云平台软件，实现农机按照预先设定的规划路径自动行驶，促使农业生产更高效、更简便、更安全、更可靠。\r\n              公司®精准农业解决方案由北斗农机自动驾驶系统、北斗农机耕深探测仪、北斗农业云平台、北斗农机自动驾驶仪服务平台四部分组成。\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\" style=\"padding-bottom: 0px\">\r\n      <div class=\"part\">\r\n        <div class=\"application_left\">\r\n          <p>北斗农机自动驾驶系统</p>\r\n          <p></p>\r\n          <p>\r\n            北斗农机自动导航驾驶系统车载部分由卫星接收天线、车载显示屏，北斗高精度车载定位终端、行车控制器、液压阀（或方向盘）、角度传感器等部分组成。利用高精度的北斗卫星定位系统，用行车控制器对农机液压系统进行控制，农机可以按照设定的路线自动行驶，并在车载显示器上显示相关图形化信息。\r\n            <br />\r\n            1、24小时工作，解放劳动力，提高生产力\r\n            <br />\r\n            2、适用于整地、开沟、起垄、插秧、施肥、收获等各个农业生产环节\r\n            <br />\r\n            3、提高作业精度，符合标准化农业要求，提高收获质量 4、 操作简单易上手\r\n            <br />\r\n            5、性能可靠，值得信赖\r\n          </p>\r\n        </div>\r\n        <div class=\"nongji_right\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\" style=\"padding-bottom: 0px\">\r\n      <div class=\"part\">\r\n        <div class=\"application_left\">\r\n          <p>北斗农机耕深探测仪</p>\r\n          <p></p>\r\n          <p>\r\n            北斗农机耕深探测仪由作业显示终端、惯导传感器、北斗导航传感器、摄像头等小型精密设备组成，能够实时显示作业耕深信息、作业记亩并定时通过相机拍照观察农具状态，同时可以通过无线网络与后台数据管理服务器相连，共同构成了农机深松作业信息化监管服务系统，为深松作业补贴提供量化依据，提升了农机作业管理信息化水平。\r\n            <br />\r\n            1、耕深检测：实时显示耕深值并传输给后台数据库，平均精度达到厘米级\r\n            <br />\r\n            2、实时定位农具并观察农具状态 3、操作简单易上手\r\n            <br />\r\n            4、性能可靠，符合深松作业要求\r\n          </p>\r\n        </div>\r\n        <div class=\"nongjitance_right\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\" style=\"padding-bottom: 0px\">\r\n      <div class=\"part\">\r\n        <div class=\"application_left\">\r\n          <p>北斗农业平台</p>\r\n          <p></p>\r\n          <p>\r\n            北斗农业云平台集成北斗卫星导航系统、LBS基站和北斗农机自动设备，进行信息收集与管理，实现农机定位、科学作业等，还能够随时掌握农机的耕种深度、维修信息、报警信息等，实现集中管理、科学调度，省时省事省力。\r\n          </p>\r\n        </div>\r\n        <div class=\"nongjipingtai_right\"></div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bk\">\r\n      <div class=\"part\">\r\n        <div class=\"application_left\">\r\n          <p>北斗农机自动驾驶仪服务平台</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"last_img\"></div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiBeidou',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items: [\r\n        {\r\n          id: 1,\r\n          title: '高精度定位',\r\n          content: '全天24小时定位，高精度定位。',\r\n          src: require('@/assets/images/item/beidou/1.png'),\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '路线查询',\r\n          content: '通过轨迹查询，路线回放。',\r\n          src: require('@/assets/images/item/beidou/5.png'),\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '全程过程管理',\r\n          content: '人车工作状态动态管理。',\r\n          src: require('@/assets/images/item/beidou/2.png'),\r\n        },\r\n        {\r\n          id: 4,\r\n          title: '行程管理',\r\n          content: '实时了解人员位置。',\r\n          src: require('@/assets/images/item/beidou/6.png'),\r\n        },\r\n        {\r\n          id: 5,\r\n          title: '安全管理',\r\n          content: '通过全程位置监控，控制安全。',\r\n          src: require('../../../assets/images/item/beidou/3.png'),\r\n        },\r\n        {\r\n          id: 6,\r\n          title: '指挥调度',\r\n          content: '针对生产目标，应急事件优化。',\r\n          src: require('../../../assets/images/item/beidou/4.png'),\r\n        },\r\n        {\r\n          id: 7,\r\n          title: '区域报警',\r\n          content: '超出规定范围，立即报警。',\r\n          src: require('../../../assets/images/item/beidou/7.png'),\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n.body {\r\n  .tbk {\r\n    background: #f8f8f8;\r\n  }\r\n}\r\n.bk {\r\n  display: flex;\r\n  flex-direction: row;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  padding-top: 80px;\r\n  padding-bottom: 82px;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  .part_title {\r\n    display: flex;\r\n    margin-right: 40px;\r\n    .part_title_bar {\r\n      width: 6px;\r\n      height: 36px;\r\n      background: linear-gradient(0deg, #0cb8fa 0%, #5a42ec 100%);\r\n      margin-top: 8px;\r\n      margin-right: 10px;\r\n    }\r\n    .part_title_text {\r\n      width: 400px;\r\n      font-size: 38px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n      color: #333333;\r\n      line-height: 50px;\r\n    }\r\n  }\r\n  .part_text {\r\n    font-size: 14px;\r\n    font-family: Microsoft YaHei;\r\n    font-weight: 300;\r\n    color: #333333;\r\n    line-height: 30px;\r\n  }\r\n}\r\n.left_text {\r\n  width: 150%;\r\n  margin-right: 68px;\r\n  p:nth-child(1) {\r\n    font-size: 30px;\r\n    font-family: Microsoft YaHei;\r\n    font-weight: 300;\r\n    color: #333333;\r\n    line-height: 30px;\r\n    margin-bottom: 28px;\r\n  }\r\n  p:nth-child(2) {\r\n    font-size: 14px;\r\n    font-family: Microsoft YaHei;\r\n    font-weight: 300;\r\n    color: #333333;\r\n    line-height: 30px;\r\n  }\r\n}\r\n.right_text {\r\n  margin-top: 90px;\r\n  ul {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    list-style: none;\r\n    li {\r\n      width: 300px;\r\n      margin-bottom: 10px;\r\n      display: flex;\r\n      .right_text_li_icon {\r\n        height: 24px;\r\n        width: 24px;\r\n        margin-right: 6px;\r\n        background-size: 100%;\r\n      }\r\n      .right_text_li_text {\r\n        p:nth-child(1) {\r\n          font-size: 10px;\r\n          font-weight: bold;\r\n        }\r\n        p:nth-child(2) {\r\n          font-size: 6px;\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n.main {\r\n  width: 1200px;\r\n  p {\r\n    font-size: 30px;\r\n    font-family: Microsoft YaHei;\r\n    font-weight: 300;\r\n    color: #333333;\r\n    line-height: 30px;\r\n    margin-bottom: 28px;\r\n  }\r\n  .main_img {\r\n    width: 1154px;\r\n    height: 137px;\r\n    background: url('~@/assets/images/item/beidou/main.png');\r\n  }\r\n}\r\n.application_left {\r\n  width: 644px;\r\n  margin-right: 66px;\r\n  p:nth-child(1) {\r\n    font-size: 30px;\r\n    font-family: Microsoft YaHei;\r\n    font-weight: 300;\r\n    color: #333333;\r\n    line-height: 30px;\r\n    margin-bottom: 28px;\r\n  }\r\n  p:nth-child(2) {\r\n    font-size: 14px;\r\n    font-family: Microsoft YaHei;\r\n    font-weight: bold;\r\n    color: #333333;\r\n    line-height: 30px;\r\n  }\r\n  p:nth-child(3) {\r\n    font-size: 14px;\r\n    font-family: Microsoft YaHei;\r\n    color: #333333;\r\n    line-height: 30px;\r\n  }\r\n}\r\n.application_right {\r\n  width: 431px;\r\n  height: 251px;\r\n  background: url('~@/assets/images/item/beidou/reward.png');\r\n}\r\n.content_right_img {\r\n  height: 187px;\r\n  width: 482px;\r\n  background: url('~@/assets/images/item/beidou/content.png') no-repeat;\r\n}\r\n.nongji_right {\r\n  width: 431px;\r\n  height: 300px;\r\n  background: url('~@/assets/images/item/beidou/nongji1.png') no-repeat;\r\n  background-size: 100%;\r\n}\r\n.nongjitance_right {\r\n  width: 431px;\r\n  height: 251px;\r\n  background: url('~@/assets/images/item/beidou/nongji2.png') no-repeat;\r\n  background-size: 100%;\r\n}\r\n.nongjipingtai_right {\r\n  width: 477px;\r\n  height: 80px;\r\n  background: url('~@/assets/images/item/beidou/nongji3.png') no-repeat;\r\n  background-size: 100%;\r\n}\r\n.last_img {\r\n  margin: 0 auto;\r\n  width: 1000px;\r\n  height: 550px;\r\n  background: url('~@/assets/images/item/beidou/lastImg.png') no-repeat;\r\n}\r\n</style>\r\n\r\n"],"mappings":"AAgMA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA,GACA;QACAC,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA,GACA;QACAJ,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA,GACA;QACAJ,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA,GACA;QACAJ,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA,GACA;QACAJ,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA,GACA;QACAJ,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA,GACA;QACAJ,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,GAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}