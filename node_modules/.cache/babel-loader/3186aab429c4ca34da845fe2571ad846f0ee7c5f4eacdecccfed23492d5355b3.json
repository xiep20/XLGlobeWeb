{"ast":null,"code":"export default {\n  name: 'ZhihuiGuihua',\n  props: {},\n  data: function data() {\n    return {\n      items_feature: [{\n        id: 1,\n        itemTitle: '/// 全业务全流程',\n        itemText: '提供自动化、信息化评价自然资源承载力、国土空间开发适宜性以及国土空间规划实施评估和风险识别评估的功能，为国土空间规划的编制提供支持。'\n      }, {\n        id: 2,\n        itemTitle: '/// 智能化科学评价',\n        itemText: '通过系统可对管线进行运行监测，管线漏损点定位、线路巡检、实时监测预警及应急处理管理等。'\n      }, {\n        id: 3,\n        itemTitle: '/// 成果审查流程化',\n        itemText: '按照审查办法及传导要求，提供空间一致性、空间准入性、空间符合性、规划冲突、指标符合性、图数一致性、图文一致性、文本规范与约束、突破政策法规等审查功能。'\n      }, {\n        id: 4,\n        itemTitle: '/// 规划实施精准化',\n        itemText: '提供与不动产登记、土地供应业务系统、工程建设项目审批系统衔接，并提供规划底图服务、合规性审查功能、行政区划底图等服务。'\n      }, {\n        id: 5,\n        itemTitle: '/// 监测预警动态化',\n        itemText: '通过对各类管控边界、约束性指标等的实时监测，提供监测管理、监测指标转换、监测分析与报告、体检指标管理、监测可视化展示等功能。'\n      }, {\n        id: 6,\n        itemTitle: '/// 指标模型定制化',\n        itemText: '通过算法注册、数据源管理及配套可视化工具进行模型构建，为国土空间规划编制、审查、实施、监测、评估和预警等提供模型计算支撑。'\n      }],\n      items_application: [{\n        id: 1,\n        imgSrc: require('@/assets/images/application/zhgh_application1.png')\n      }, {\n        id: 2,\n        imgSrc: require('@/assets/images/application/zhgh_application2.png')\n      }, {\n        id: 3,\n        imgSrc: require('../../../assets/images/application/zhgh_application3.png')\n      }, {\n        id: 4,\n        imgSrc: require('../../../assets/images/application/zhgh_application4.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items_feature","id","itemTitle","itemText","items_application","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuiguihua.vue"],"sourcesContent":["<template>\r\n  <div class=\"body\">\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p style=\"width: 360px\">\r\n              国土空间规划一张图\r\n              <br />\r\n              实施监督信息系统\r\n            </p>\r\n          </div>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <p>\r\n            依托公司国土空间基础信息平台，围绕国土空间规划编制、核查、审批、实施、监测评估预警全过程，搭建国土空间规划“一张图”实施监管信息系统。以目标、问题和可操作为导向，搭建监测评估预警指标体系、专项评估及预警模型，增加选址意见书等信息，实现了国土空间规划辅助编制、成果核对和审批、国土空间用途管制支撑和资源环境承载能力监测预警，对国土空间规划实施情况开展长期监测、定期和不定期评估、及时预警，全面提升国土空间治理体系和治理能力现代化水平。\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>系统特点</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        <ul class=\"right_ul\">\r\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\r\n            <p>{{ item.itemTitle }}</p>\r\n            <p>{{ item.itemText }}</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>应用案例</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"main_text\">\r\n        <p>\r\n          公司国土空间规划“一张图”实施监督信息系统围绕广水市自然资源局机构改革后的自然资源业务需求，完善广水市国土空间大数据体系，通过开展国土空间大数据集成、智能分析广水市规划编制、精准实施及监测评估，建设国土空间规划“一张图”应用、国土空间规划分析评价、国土空间规划成果审查与管理、国土空间规划监测评估预警、资源环境承载能力监测预警、指标模型管理6个子系统，辅助编制、辅助审批、许可信息管理3个拓展系统，三维规划辅助决策应用、领导驾驶舱、管理人员工作台3个创新应用系统；全面服务支撑广水市国土空间规划编制、审批、实施、监测评估预警全过程。\r\n        </p>\r\n      </div>\r\n      <div class=\"main_application\">\r\n        <ul>\r\n          <li v-for=\"item in items_application\" :key=\"item.id\">\r\n            <div\r\n              class=\"main_applicationImg\"\r\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\r\n            ></div>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiGuihua',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items_feature: [\r\n        {\r\n          id: 1,\r\n          itemTitle: '/// 全业务全流程',\r\n          itemText:\r\n            '提供自动化、信息化评价自然资源承载力、国土空间开发适宜性以及国土空间规划实施评估和风险识别评估的功能，为国土空间规划的编制提供支持。',\r\n        },\r\n        {\r\n          id: 2,\r\n          itemTitle: '/// 智能化科学评价',\r\n          itemText:\r\n            '通过系统可对管线进行运行监测，管线漏损点定位、线路巡检、实时监测预警及应急处理管理等。',\r\n        },\r\n        {\r\n          id: 3,\r\n          itemTitle: '/// 成果审查流程化',\r\n          itemText:\r\n            '按照审查办法及传导要求，提供空间一致性、空间准入性、空间符合性、规划冲突、指标符合性、图数一致性、图文一致性、文本规范与约束、突破政策法规等审查功能。',\r\n        },\r\n        {\r\n          id: 4,\r\n          itemTitle: '/// 规划实施精准化',\r\n          itemText:\r\n            '提供与不动产登记、土地供应业务系统、工程建设项目审批系统衔接，并提供规划底图服务、合规性审查功能、行政区划底图等服务。',\r\n        },\r\n        {\r\n          id: 5,\r\n          itemTitle: '/// 监测预警动态化',\r\n          itemText:\r\n            '通过对各类管控边界、约束性指标等的实时监测，提供监测管理、监测指标转换、监测分析与报告、体检指标管理、监测可视化展示等功能。',\r\n        },\r\n        {\r\n          id: 6,\r\n          itemTitle: '/// 指标模型定制化',\r\n          itemText:\r\n            '通过算法注册、数据源管理及配套可视化工具进行模型构建，为国土空间规划编制、审查、实施、监测、评估和预警等提供模型计算支撑。',\r\n        },\r\n      ],\r\n      items_application: [\r\n        {\r\n          id: 1,\r\n          imgSrc: require('@/assets/images/application/zhgh_application1.png'),\r\n        },\r\n        {\r\n          id: 2,\r\n          imgSrc: require('@/assets/images/application/zhgh_application2.png'),\r\n        },\r\n        {\r\n          id: 3,\r\n          imgSrc: require('../../../assets/images/application/zhgh_application3.png'),\r\n        },\r\n        {\r\n          id: 4,\r\n          imgSrc: require('../../../assets/images/application/zhgh_application4.png'),\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.wbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #fff;\r\n}\r\n.gbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #f8f8f8;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  padding: 80px 0;\r\n}\r\n.left_title {\r\n  display: flex;\r\n  margin-right: 90px;\r\n}\r\n.left_title_icon {\r\n  width: 6px;\r\n  height: 36px;\r\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\r\n  margin-top: 8px;\r\n  margin-right: 10px;\r\n}\r\n.left_title_text {\r\n  font-size: 38px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: bold;\r\n  color: #333333;\r\n  line-height: 50px;\r\n}\r\n.right_text {\r\n  width: 780px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 300;\r\n  color: #333333;\r\n  line-height: 30px;\r\n}\r\n.mainImg {\r\n  width: 1245px;\r\n  height: 808px;\r\n  margin-left: 400px;\r\n  margin-top: -40px;\r\n  margin-bottom: 20px;\r\n  background: url('~@/assets/images/application/zhgw_main.png');\r\n}\r\n.right_ul {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  width: 1200px;\r\n  margin-top: -40px;\r\n  list-style: none;\r\n  padding-bottom: 80px;\r\n  li {\r\n    width: 520px;\r\n    height: 170px;\r\n    padding: 40px;\r\n    p:nth-child(1) {\r\n      margin-bottom: 30px;\r\n      font-size: 18px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n    }\r\n    p:nth-child(2) {\r\n      font-size: 14px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: 300;\r\n      line-height: 30px;\r\n    }\r\n  }\r\n  li:nth-child(2) {\r\n    color: #333333;\r\n    background: #f8f8f8;\r\n  }\r\n  li:nth-child(3) {\r\n    color: #333333;\r\n    background: #f8f8f8;\r\n  }\r\n  li:nth-child(1) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nt