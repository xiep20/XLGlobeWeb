{"ast":null,"code":"export default {\n  name: 'ZhihuiChengguan',\n  props: {},\n  data: function data() {\n    return {\n      items_feature: [{\n        id: 1,\n        itemTitle: '/// 更全面的感知',\n        itemText: '通过北斗/GPS、遥感影像、二维码、RFID、智能视频分析、公众感知等手段，实现更全面的感知。'\n      }, {\n        id: 2,\n        itemTitle: '/// 更广泛的参与',\n        itemText: '进一步优化改善信息采集与业务监督、指挥、处理、评价等多部门协同工作的流程，缩短发现、反馈、处理问题的周期，与责任单位的协同处置更广泛。'\n      }, {\n        id: 3,\n        itemTitle: '/// 更广泛的参与',\n        itemText: '采用微信、微博、城管通、网站等平台，收集公众上报问题，增强城市管理部门与公众之间的互动，提升公众参与城市管理的热情，实现全民城管。'\n      }, {\n        id: 4,\n        itemTitle: '/// 更先进的技术',\n        itemText: '优化原有数字城管系统界面，重设系统表单，采用HTML5页面技术，实现多浏览器支持，升级原有系统功能，满足智慧城管系统使用需求。'\n      }, {\n        id: 5,\n        itemTitle: '/// 更精细的管理',\n        itemText: '综合现有可用资源与行业应用，基于数据，实现城市管理的事前、事中、事后的全过程精细化管理。'\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items_feature","id","itemTitle","itemText","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuichengguan.vue"],"sourcesContent":["<template>\r\n  <div class=\"body\">\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p style=\"width: 300px\">智慧城管 <br />解决方案</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <p>\r\n            公司在智慧城市框架下，不断推进技术应用创新和管理模式创新，结合城市管理实际需求，对“数字城管”信息平台进行提升和创新，着力打造智慧城市管理新格局。通过融合物联网、3G/4G通信、时空信息、云计算、大数据分析技术、虚拟化技术等多项前沿技术，建立智能程度更高、感知更全面的智慧城市管理平台，并运用互联网思维及城市治理理念，创新城市管理运营模式，建立科学的智慧管理新体系，真正实现从管理到服务、从治理到运营，从相对独立到协同一体的智慧城市精益化管理新模式。\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>系统特点</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        <ul class=\"right_ul\">\r\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\r\n            <p>{{ item.itemTitle }}</p>\r\n            <p>{{ item.itemText }}</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiChengguan',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items_feature: [\r\n        {\r\n          id: 1,\r\n          itemTitle: '/// 更全面的感知',\r\n          itemText:\r\n            '通过北斗/GPS、遥感影像、二维码、RFID、智能视频分析、公众感知等手段，实现更全面的感知。',\r\n        },\r\n        {\r\n          id: 2,\r\n          itemTitle: '/// 更广泛的参与',\r\n          itemText:\r\n            '进一步优化改善信息采集与业务监督、指挥、处理、评价等多部门协同工作的流程，缩短发现、反馈、处理问题的周期，与责任单位的协同处置更广泛。',\r\n        },\r\n        {\r\n          id: 3,\r\n          itemTitle: '/// 更广泛的参与',\r\n          itemText:\r\n            '采用微信、微博、城管通、网站等平台，收集公众上报问题，增强城市管理部门与公众之间的互动，提升公众参与城市管理的热情，实现全民城管。',\r\n        },\r\n        {\r\n          id: 4,\r\n          itemTitle: '/// 更先进的技术',\r\n          itemText:\r\n            '优化原有数字城管系统界面，重设系统表单，采用HTML5页面技术，实现多浏览器支持，升级原有系统功能，满足智慧城管系统使用需求。',\r\n        },\r\n        {\r\n          id: 5,\r\n          itemTitle: '/// 更精细的管理',\r\n          itemText:\r\n            '综合现有可用资源与行业应用，基于数据，实现城市管理的事前、事中、事后的全过程精细化管理。',\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.wbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #fff;\r\n}\r\n.gbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #f8f8f8;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  padding: 80px 0;\r\n}\r\n.left_title {\r\n  display: flex;\r\n  margin-right: 90px;\r\n}\r\n.left_title_icon {\r\n  width: 6px;\r\n  height: 36px;\r\n  background: linear-gradient(0deg, #0cb8fa 0%, #5a42ec 100%);\r\n  margin-top: 8px;\r\n  margin-right: 10px;\r\n}\r\n.left_title_text {\r\n  font-size: 38px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: bold;\r\n  color: #333333;\r\n  line-height: 50px;\r\n}\r\n.right_text {\r\n  width: 780px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 300;\r\n  color: #333333;\r\n  line-height: 30px;\r\n}\r\n.mainImg {\r\n  width: 1245px;\r\n  height: 808px;\r\n  margin-left: 400px;\r\n  margin-top: -40px;\r\n  margin-bottom: 20px;\r\n  background: url('~@/assets/images/application/zhgw_main.png');\r\n}\r\n.right_ul {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  width: 1200px;\r\n  margin-top: -40px;\r\n  margin-bottom: 40px;\r\n  list-style: none;\r\n  padding-bottom: 80px;\r\n  li {\r\n    width: 520px;\r\n    height: 180px;\r\n    padding: 40px;\r\n    p:nth-child(1) {\r\n      margin-bottom: 30px;\r\n      font-size: 18px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n    }\r\n    p:nth-child(2) {\r\n      font-size: 20px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: 300;\r\n      line-height: 30px;\r\n    }\r\n  }\r\n  li:nth-child(2) {\r\n    color: #333333;\r\n    background: #fff;\r\n  }\r\n  li:nth-child(3) {\r\n    color: #333333;\r\n    background: #fff;\r\n  }\r\n  li:nth-child(1) {\r\n    color: #f8f8f8;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(4) {\r\n    color: #f8f8f8;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(5) {\r\n    color: #f8f8f8;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(6) {\r\n    color: #333333;\r\n    background: #fff;\r\n  }\r\n}\r\n.main_text {\r\n  width: 1198px;\r\n  margin-top: -40px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 400;\r\n  color: #666666;\r\n  line-height: 28px;\r\n}\r\n.main_application {\r\n  width: 1198px;\r\n  margin-top: 20px;\r\n  margin-bottom: 81px;\r\n  ul {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    list-style: none;\r\n    margin-top: 20px;\r\n    li:nth-child(1) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        margin-right: 10px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(2) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(3) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        margin-right: 10px;\r\n        margin-top: 10px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(4) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        margin-top: 10px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAuCA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,aAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}