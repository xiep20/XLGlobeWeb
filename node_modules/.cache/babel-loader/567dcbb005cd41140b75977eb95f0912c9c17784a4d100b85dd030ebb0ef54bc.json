{"ast":null,"code":"export default {\n  name: 'ZhihuiJiaotong',\n  props: {},\n  data: function data() {\n    return {\n      items: [{\n        id: 1,\n        itemTitle: '智慧城市时空信息云平台',\n        itemText: '以北斗时空为基准，以位置服务为核心，通过大数据、物联网、云计算等新一代信息技术，实时汇集城市各种时空信息，形成感知更透彻、互联更广泛、决策更智能、服务更灵活、更加安全可靠的智慧城市时空信息平台，是新型智慧城市建设的重要空间信息基础设施。'\n      }, {\n        id: 2,\n        itemTitle: '时空大数据中心',\n        itemText: '基于北斗卫星导航定位技术建设的综合性高精度位置服务体系，融合大数据、高性能云计算和海量云存储技术，为政府部门、行业用户、大众用户提供基于高精度位置导航、监控、调度和分析决策技术支持服务。'\n      }, {\n        id: 3,\n        itemTitle: '北斗高精度位置服务云平台',\n        itemText: '通过对时空大数据的收集和各种业务系统库的对接，将不同来源、不同类型、不同应用的时空数据进行集中、规范的整合；并通过基础地理信息平台完成数据发布和资源共享，形成智慧城市的“知识库”。'\n      }],\n      items_feature: [{\n        id: 1,\n        title: '交通“一张图”',\n        content: '整合基础地图、交通设施、路况信息、实时天气等多源数据，实现专业级交通数据的标准化管理、发布和共享，打造基于交通数据“一张图”的可视化管理和分析平台。'\n      }, {\n        id: 2,\n        title: '车辆实时监控',\n        content: '实现车辆的地图可视化监控，了解车辆的位置、速度、行驶状态等信息，帮助管理者及时了解每一辆车当前的运营状态。'\n      }, {\n        id: 3,\n        title: '车辆运营分析',\n        content: '让企业实时掌控车资产整体情况和每辆车的运营细节。通过对司机驾驶行为，车辆利用率，车况等常见项，以及可制化业务数据的分析，为企业进行精细化管理提供科学依据。'\n      }, {\n        id: 4,\n        title: '主动安全保障',\n        content: '超速、疲劳驾驶、三急等违规驾驶行为实时报警；结合地理围栏，对车辆晚点，偏离预定轨迹，非法进入禁区等预设置的异常情况进行实时报警，让管理者第一时间得到通知。'\n      }],\n      items_good: [{\n        id: 1,\n        title: '专业交通数据',\n        content: '拥有全国高精度路网、里程桩、营运车辆、路况信息、实时天气等动静态专业数据，为交通业务应用提供数据支撑。',\n        imgSrc: require('@/assets/images/application/zhjt_good2.png')\n      }, {\n        id: 2,\n        title: '海量数据智能监管',\n        content: '依托平台能力，实现千万级实时数据智能化监控，并结合交通业务指标，提升交通行业精准化管理和监控水平。',\n        imgSrc: require('../../../assets/images/application/zhjt_good1.png')\n      }, {\n        id: 3,\n        title: '丰富的分析经验',\n        content: '丰富的多维、多时序的大数据运营经验，通过对车辆轨迹、驾驶行为等数据挖掘分析，科学辅助企业业务决策。',\n        imgSrc: require('../../../assets/images/application/zhjt_good3.png')\n      }, {\n        id: 4,\n        title: '技术团队服务保障',\n        content: '团队也将以多年项目交付中积累的经验为基础，为用户与合作伙伴提供包括工具学习、技术支持、项目咨询等系列服务，助力项目实施与交付。',\n        imgSrc: require('../../../assets/images/application/zhjt_good4.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items","id","itemTitle","itemText","items_feature","title","content","items_good","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuijiaotong.vue"],"sourcesContent":["\n<template>\n  <div class=\"body\">\n    <div class=\"wbk\">\n      <div class=\"part\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>智慧交通</p>\n          </div>\n        </div>\n        <div class=\"right_text\">\n          <p>\n            以国家智能交通系统体系框架为指导，建成\"高效、安全、环保、舒适、文明\"的智慧交通与运输体系;大幅度提高城市交通运输系统的管理水平和运行效率，为出行者提供全方位的交通信息服务和便利、高效、快捷、经济、安全、人性、智能的交通运输服务;为交通管理部门和相关企业提供及时、准确、全面和充分的信息支持和信息化决策支持。\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"gbk\">\n      <div class=\"part\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>方案概述</p>\n          </div>\n        </div>\n      </div>\n      <div class=\"main_text\">\n        <p>\n          公司在交通运输领域充分利用物联网、空间感知、云计算、移动互联网等新一代信息技术，综合运用交通科学、系统方法、人工智能、知识挖掘等理论与工具，通过建设实时的动态信息服务体系，深度挖掘交通运输相关数据，形成问题分析模型，推动交通运输更安全、更高效、更便捷、更经济、更环保、更舒适的运行和发展，带动交通运输相关产业转型、升级。\n        </p>\n      </div>\n      <div class=\"mainImg\" style=\"margin-bottom:80px\"></div>\n    </div>\n\n    <div class=\"wbk\">\n      <div class=\"part\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>核心优势</p>\n          </div>\n        </div>\n      </div>\n      <div>\n        <ul class=\"good_ul\">\n          <li class=\"good_li\" v-for=\"item in items_good\" :key=\"item.id\">\n            <div\n              class=\"good_ul_icon\"\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\n            ></div>\n            <p class=\"good_p1\">{{ item.title }}</p>\n            <p class=\"good_p2\">{{ item.content }}</p>\n          </li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"gbk\">\n      <div class=\"part\">\n        <div class=\"left_title\">\n          <div class=\"left_title_icon\"></div>\n          <div class=\"left_title_text\">\n            <p>系统特点</p>\n          </div>\n        </div>\n      </div>\n      <div>\n        <ul class=\"right_ul\">\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\n            <p>{{ item.title }}</p>\n            <p>{{ item.content }}</p>\n          </li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  name: 'ZhihuiJiaotong',\n  props: {},\n  data() {\n    return {\n      items: [\n        {\n          id: 1,\n          itemTitle: '智慧城市时空信息云平台',\n          itemText:\n            '以北斗时空为基准，以位置服务为核心，通过大数据、物联网、云计算等新一代信息技术，实时汇集城市各种时空信息，形成感知更透彻、互联更广泛、决策更智能、服务更灵活、更加安全可靠的智慧城市时空信息平台，是新型智慧城市建设的重要空间信息基础设施。',\n        },\n        {\n          id: 2,\n          itemTitle: '时空大数据中心',\n          itemText:\n            '基于北斗卫星导航定位技术建设的综合性高精度位置服务体系，融合大数据、高性能云计算和海量云存储技术，为政府部门、行业用户、大众用户提供基于高精度位置导航、监控、调度和分析决策技术支持服务。',\n        },\n        {\n          id: 3,\n          itemTitle: '北斗高精度位置服务云平台',\n          itemText:\n            '通过对时空大数据的收集和各种业务系统库的对接，将不同来源、不同类型、不同应用的时空数据进行集中、规范的整合；并通过基础地理信息平台完成数据发布和资源共享，形成智慧城市的“知识库”。',\n        },\n      ],\n      items_feature: [\n        {\n          id: 1,\n          title: '交通“一张图”',\n          content:\n            '整合基础地图、交通设施、路况信息、实时天气等多源数据，实现专业级交通数据的标准化管理、发布和共享，打造基于交通数据“一张图”的可视化管理和分析平台。',\n        },\n        {\n          id: 2,\n          title: '车辆实时监控',\n          content:\n            '实现车辆的地图可视化监控，了解车辆的位置、速度、行驶状态等信息，帮助管理者及时了解每一辆车当前的运营状态。',\n        },\n        {\n          id: 3,\n          title: '车辆运营分析',\n          content:\n            '让企业实时掌控车资产整体情况和每辆车的运营细节。通过对司机驾驶行为，车辆利用率，车况等常见项，以及可制化业务数据的分析，为企业进行精细化管理提供科学依据。',\n        },\n        {\n          id: 4,\n          title: '主动安全保障',\n          content:\n            '超速、疲劳驾驶、三急等违规驾驶行为实时报警；结合地理围栏，对车辆晚点，偏离预定轨迹，非法进入禁区等预设置的异常情况进行实时报警，让管理者第一时间得到通知。',\n        },\n      ],\n      items_good: [\n        {\n          id: 1,\n          title: '专业交通数据',\n          content:\n            '拥有全国高精度路网、里程桩、营运车辆、路况信息、实时天气等动静态专业数据，为交通业务应用提供数据支撑。',\n          imgSrc: require('@/assets/images/application/zhjt_good2.png'),\n        },\n        {\n          id: 2,\n          title: '海量数据智能监管',\n          content:\n            '依托平台能力，实现千万级实时数据智能化监控，并结合交通业务指标，提升交通行业精准化管理和监控水平。',\n          imgSrc: require('../../../assets/images/application/zhjt_good1.png'),\n        },\n        {\n          id: 3,\n          title: '丰富的分析经验',\n          content:\n            '丰富的多维、多时序的大数据运营经验，通过对车辆轨迹、驾驶行为等数据挖掘分析，科学辅助企业业务决策。',\n          imgSrc: require('../../../assets/images/application/zhjt_good3.png'),\n        },\n        {\n          id: 4,\n          title: '技术团队服务保障',\n          content:\n            '团队也将以多年项目交付中积累的经验为基础，为用户与合作伙伴提供包括工具学习、技术支持、项目咨询等系列服务，助力项目实施与交付。',\n          imgSrc: require('../../../assets/images/application/zhjt_good4.png'),\n        },\n      ],\n    }\n  },\n  watch: {},\n  mounted() {},\n  methods: {},\n}\n</script>\n<style lang=\"less\" scoped>\n.wbk {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  background: #fff;\n}\n.gbk {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  background: #f8f8f8;\n}\n.part {\n  display: flex;\n  width: 1200px;\n  padding: 80px 0;\n}\n.left_title {\n  display: flex;\n  margin-right: 90px;\n}\n.left_title_icon {\n  width: 6px;\n  height: 36px;\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\n  margin-top: 8px;\n  margin-right: 10px;\n}\n.left_title_text {\n  width: 230px;\n  font-size: 38px;\n  font-family: Microsoft YaHei;\n  font-weight: bold;\n  color: #333333;\n  line-height: 50px;\n}\n.right_text {\n  width: 870px;\n  font-size: 14px;\n  font-family: Microsoft YaHei;\n  font-weight: 300;\n  color: #333333;\n  line-height: 30px;\n}\n.mainImg {\n  width: 1200px;\n  height: 605px;\n  margin-top: 28px;\n  background: url('~@/assets/images/application/zhjt_main.png');\n}\n.right_ul {\n  display: flex;\n  flex-wrap: wrap;\n  width: 1200px;\n  margin-top: -40px;\n  list-style: none;\n  padding-bottom: 80px;\n  li {\n    width: 520px;\n    height: 140px;\n    padding: 40px;\n    p:nth-child(1) {\n      position: relative;\n      top: 130px;\n      bottom: 0px;\n      margin: 0 auto;\n      font-size: 18px;\n      font-family: Microsoft YaHei;\n      font-weight: bold;\n    }\n    p:nth-child(2) {\n      margin-top: -18px;\n      font-size: 14px;\n      font-family: Microsoft YaHei;\n      font-weight: 400;\n    }\n  }\n  li:nth-child(2) {\n    color: #333333;\n    background: #ffffff;\n  }\n  li:nth-child(3) {\n    color: #333333;\n    background: #ffffff;\n  }\n  li:nth-child(1) {\n    color: #ffffff;\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\n  }\n  li:nth-child(4) {\n    color: #ffffff;\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\n  }\n}\n.main_text {\n  width: 1200px;\n  margin-top: -40px;\n  font-size: 14px;\n  font-family: Microsoft YaHei;\n  font-weight: 400;\n  color: #666666;\n  line-height: 28px;\n}\n.main_application {\n  width: 1198px;\n  margin-top: 20px;\n  margin-bottom: 81px;\n  ul {\n    display: flex;\n    flex-wrap: wrap;\n    list-style: none;\n    .main_applicationImg {\n      height: 300px;\n      width: 590px;\n      margin-bottom: 9px;\n      margin-right: 9px;\n      background-size: 100%;\n    }\n  }\n}\n.good_ul {\n  display: flex;\n  flex-wrap: wrap;\n  width: 1200px;\n  margin-top: -40px;\n  list-style: none;\n  padding-bottom: 80px;\n  li {\n    width: 250px;\n    height: 286px;\n    padding: 32px 17px 32px 32px;\n    border-left: 1px solid #ededed;\n    .good_ul_icon {\n      width: 44px;\n      height: 44px;\n      margin-bottom: 24px;\n    }\n  }\n}\n.good_p1 {\n  position: relative;\n  top: 200px;\n  font-size: 26px;\n  font-family: Microsoft YaHei;\n  font-weight: bold;\n  color: #333333;\n}\n.good_p2 {\n  font-size: 14px;\n  font-family: Microsoft YaHei;\n  font-weight: 300;\n  color: #666666;\n}\n</style>\n"],"mappings":"AAgFA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,EACA;MACAC,aAAA,GACA;QACAH,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAL,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAL,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,GACA;QACAL,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;MACA,EACA;MACAC,UAAA,GACA;QACAN,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;QACAE,MAAA,EAAAC,OAAA;MACA,GACA;QACAR,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;QACAE,MAAA,EAAAC,OAAA;MACA,GACA;QACAR,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;QACAE,MAAA,EAAAC,OAAA;MACA,GACA;QACAR,EAAA;QACAI,KAAA;QACAC,OAAA,EACA;QACAE,MAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}