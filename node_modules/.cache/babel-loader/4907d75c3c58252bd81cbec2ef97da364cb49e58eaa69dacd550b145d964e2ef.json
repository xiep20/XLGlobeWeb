{"ast":null,"code":"export default {\n  name: 'ZhihuiZhihui',\n  props: {},\n  data: function data() {\n    return {\n      items_feature: [{\n        id: 1,\n        itemTitle: '/// 值班值守',\n        itemText: '覆盖省、地市、区县三级，实现智慧中心/值班室电话、传真、短信、移动APP等多种接受（报送）事件信息，支持事件自动记录、定位标记和关联预案等功能，实现报告单快速生成、分发、信息推送等功能，方便各级领导第一时间掌握全面信息。'\n      }, {\n        id: 2,\n        itemTitle: '/// 事件处置',\n        itemText: '以事件为主线，汇聚事件处置过程中各类信息，将处置过程结构化、精细化、可视化，通过移动智慧APP实时获取一线处置人员的处置状态；对一般事件，值班人员与相关部门人员进行联系，协调进行处置；对重大事件，向领导和上级部门汇报，并启动重大事件专题处置小组。'\n      }, {\n        id: 3,\n        itemTitle: '/// 可视指挥',\n        itemText: '构建应急一张图，分别对警情、警力、视频、区域等几类资源分图层在GIS系统中显示或隐藏。支持重点人口、重要地点、物资储备等扩展要素的分图层展示。图上资源的一键式调用，实现“所见即所得”的可视指挥。对一些重要场所，如车站、机场、场馆，由于其内部空间的复杂性和重点安保的需要，可通过点云建模等方式，进行3D建模。实现基于三维GIS的可视化智慧，实现场景空间结构，关键部位的一目了然。'\n      }, {\n        id: 4,\n        itemTitle: '/// 大屏展示',\n        itemText: '以可视化图标、拼盘、动态热力图等形式对实时警情数据、各项数据指标、态势分析，分类统计等应急全要素信息有效融合与数理，在超高分辨率大屏上进行可视化综合展示及应用。'\n      }, {\n        id: 5,\n        itemTitle: '/// 移动指挥 ',\n        itemText: '通过APP实现指挥中心事件指派的接受，通过对时间处置状态（接收、到达、处置完毕等）的反馈，实现对时间处置状态的实时跟踪。一线处置人员可实时推送现场的视频以及图像，并可以实现语音对讲、视频通话、数据回传等功能，功能组成“分级责任、相互衔接”的应急指挥体系。'\n      }, {\n        id: 6,\n        itemTitle: '/// 监测预警',\n        itemText: '汇聚城市各类视频、数据资源，对各类数据进行检测预警。提供多种分析工具，以可视化图表对警情数据分析研判，以治安管控、防爆反恐、预案制定/实施、指挥调度提供有力保障。'\n      }],\n      items_application: [{\n        id: 1,\n        imgSrc: require('@/assets/images/application/zhzh_application1.png')\n      }, {\n        id: 2,\n        imgSrc: require('@/assets/images/application/zhzh_application2.png')\n      }, {\n        id: 3,\n        imgSrc: require('@/assets/images/application/zhzh_application3.png')\n      }, {\n        id: 4,\n        imgSrc: require('@/assets/images/application/zhzh_application4.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items_feature","id","itemTitle","itemText","items_application","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuizhihui.vue"],"sourcesContent":["<template>\r\n  <div class=\"body\">\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p style=\"width: 300px\">背景和趋势</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <p>\r\n            随着经济和社会的高速发展，我国城市发展已进入快速增长时期，城市规模不断扩大，人口密集度很高，遭受各种突发事件及灾害的威胁形势严峻。面对严峻的突发事件及灾害威胁，我国逐步加强了对突发公共事件的应对工作，“十一五”发展规划中更是明确地提出应急联动系统建设。为了有效预防、及时控制和消除突发公共事件带来的危害，保障人民财产安全，维护正常社会秩序，建设“应急指挥”是十分迫切和必要的。\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p style=\"width: 700px\">省级应急管理指挥调度平台</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"main_text\" style=\"margin-bottom:80px\">\r\n        <p>\r\n          平台是基于基础地理信息服务平台，建设城市风险点、危险源排查管控信息系统，实现统一管理及潜在危险预警预测。该平台通过建成分辖区、分行业领域、分种类的地图信息系统，对风险点、危险源清单化、动态化管理，保证风险点、危险源清单信息准确性、风险级别可调整性和风险可预警性。\r\n        </p>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>系统特点</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        <ul class=\"right_ul\">\r\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\r\n            <p>{{ item.itemTitle }}</p>\r\n            <p>{{ item.itemText }}</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>应用案例</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"main_text\">\r\n        <p>\r\n          省级应急管理指挥调度平台应用云计算、大数据等新技术，构建基于微服务框架、统一空间基准的空间信息服务平台，保障国家、省、市（县）三级应急业务基于“一张图”的协同联动，满足各级应急管理部门对突发灾害事件各类应急空间数据的快速上图与发布需求，为各级应急管理部门构建本级业务应用系统提供灵活、可扩展的基础服务支撑及二次开发支撑，实现各部门地理信息图层资源的共建、共享、共用，形成云端架构、弹性扩展、应用牵引、共建共享的应急管理应用服务良性生态。通过基于云平台、大数据的应急管理一张图建设，提升应急管理部自然灾害监测预警能力、提升风险识别和预报预警能力、提升指挥调度的分析研判和资源调度能力，从而提升应急管理信息化的应用支撑水平。\r\n        </p>\r\n      </div>\r\n      <div class=\"main_application\">\r\n        <ul>\r\n          <li v-for=\"item in items_application\" :key=\"item.id\">\r\n            <div\r\n              class=\"main_applicationImg\"\r\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\r\n            ></div>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiZhihui',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items_feature: [\r\n        {\r\n          id: 1,\r\n          itemTitle: '/// 值班值守',\r\n          itemText:\r\n            '覆盖省、地市、区县三级，实现智慧中心/值班室电话、传真、短信、移动APP等多种接受（报送）事件信息，支持事件自动记录、定位标记和关联预案等功能，实现报告单快速生成、分发、信息推送等功能，方便各级领导第一时间掌握全面信息。',\r\n        },\r\n        {\r\n          id: 2,\r\n          itemTitle: '/// 事件处置',\r\n          itemText:\r\n            '以事件为主线，汇聚事件处置过程中各类信息，将处置过程结构化、精细化、可视化，通过移动智慧APP实时获取一线处置人员的处置状态；对一般事件，值班人员与相关部门人员进行联系，协调进行处置；对重大事件，向领导和上级部门汇报，并启动重大事件专题处置小组。',\r\n        },\r\n        {\r\n          id: 3,\r\n          itemTitle: '/// 可视指挥',\r\n          itemText:\r\n            '构建应急一张图，分别对警情、警力、视频、区域等几类资源分图层在GIS系统中显示或隐藏。支持重点人口、重要地点、物资储备等扩展要素的分图层展示。图上资源的一键式调用，实现“所见即所得”的可视指挥。对一些重要场所，如车站、机场、场馆，由于其内部空间的复杂性和重点安保的需要，可通过点云建模等方式，进行3D建模。实现基于三维GIS的可视化智慧，实现场景空间结构，关键部位的一目了然。',\r\n        },\r\n        {\r\n          id: 4,\r\n          itemTitle: '/// 大屏展示',\r\n          itemText:\r\n            '以可视化图标、拼盘、动态热力图等形式对实时警情数据、各项数据指标、态势分析，分类统计等应急全要素信息有效融合与数理，在超高分辨率大屏上进行可视化综合展示及应用。',\r\n        },\r\n        {\r\n          id: 5,\r\n          itemTitle: '/// 移动指挥 ',\r\n          itemText:\r\n            '通过APP实现指挥中心事件指派的接受，通过对时间处置状态（接收、到达、处置完毕等）的反馈，实现对时间处置状态的实时跟踪。一线处置人员可实时推送现场的视频以及图像，并可以实现语音对讲、视频通话、数据回传等功能，功能组成“分级责任、相互衔接”的应急指挥体系。',\r\n        },\r\n        {\r\n          id: 6,\r\n          itemTitle: '/// 监测预警',\r\n          itemText:\r\n            '汇聚城市各类视频、数据资源，对各类数据进行检测预警。提供多种分析工具，以可视化图表对警情数据分析研判，以治安管控、防爆反恐、预案制定/实施、指挥调度提供有力保障。',\r\n        },\r\n      ],\r\n      items_application: [\r\n        {\r\n          id: 1,\r\n          imgSrc: require('@/assets/images/application/zhzh_application1.png'),\r\n        },\r\n        {\r\n          id: 2,\r\n          imgSrc: require('@/assets/images/application/zhzh_application2.png'),\r\n        },\r\n        {\r\n          id: 3,\r\n          imgSrc: require('@/assets/images/application/zhzh_application3.png'),\r\n        },\r\n        {\r\n          id: 4,\r\n          imgSrc: require('@/assets/images/application/zhzh_application4.png'),\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.wbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #fff;\r\n}\r\n.gbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #f8f8f8;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  padding: 80px 0;\r\n}\r\n.left_title {\r\n  display: flex;\r\n  margin-right: 90px;\r\n}\r\n.left_title_icon {\r\n  width: 6px;\r\n  height: 36px;\r\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\r\n  margin-top: 8px;\r\n  margin-right: 10px;\r\n}\r\n.left_title_text {\r\n  font-size: 38px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: bold;\r\n  color: #333333;\r\n  line-height: 50px;\r\n}\r\n.right_text {\r\n  width: 780px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 300;\r\n  color: #333333;\r\n  line-height: 30px;\r\n}\r\n.mainImg {\r\n  width: 1245px;\r\n  height: 808px;\r\n  margin-left: 400px;\r\n  margin-top: -40px;\r\n  margin-bottom: 20px;\r\n  background: url('~@/assets/images/application/zhgw_main.png');\r\n}\r\n.right_ul {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  width: 1200px;\r\n  margin-top: -40px;\r\n  list-style: none;\r\n  padding-bottom: 80px;\r\n  li {\r\n    width: 520px;\r\n    height: 320px;\r\n    padding: 40px;\r\n    p:nth-child(1) {\r\n      margin-bottom: 30px;\r\n      font-size: 18px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n    }\r\n    p:nth-child(2) {\r\n      font-size: 14px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: 300;\r\n      line-height: 35px;\r\n    }\r\n  }\r\n  li:nth-child(2) {\r\n    color: #333333;\r\n    background: #fff;\r\n  }\r\n  li:nth-child(3) {\r\n    color: #333333;\r\n    background: #fff;\r\n  }\r\n  li:nth-child(1) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(4) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(5) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(6) {\r\n    color: #333333;\r\n    background: #fff;\r\n  }\r\n}\r\n.main_text {\r\n  width: 1198px;\r\n  margin-top: -40px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 400;\r\n  color: #666666;\r\n  line-height: 28px;\r\n}\r\n.main_application {\r\n  width: 1198px;\r\n  margin-top: 20px;\r\n  margin-bottom: 81px;\r\n  ul {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    list-style: none;\r\n    margin-top: 20px;\r\n    li:nth-child(1) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        margin-right: 10px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(2) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(3) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        margin-right: 10px;\r\n        margin-top: 10px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(4) {\r\n      .main_applicationImg {\r\n        height: 332px;\r\n        width: 591px;\r\n        margin-top: 10px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAiFA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,aAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,EACA;MACAC,iBAAA,GACA;QACAH,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}