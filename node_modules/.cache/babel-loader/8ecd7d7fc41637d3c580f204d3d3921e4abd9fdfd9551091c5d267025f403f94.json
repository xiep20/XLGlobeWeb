f=\"item3.icon && item3.icon != ''\"\n                          ></i>\n                          {{ item3.name }}\n                        </el-menu-item>\n                      </template>\n                      <template v-else slot=\"title\">\n                        <i\n                          class=\"iconfont\"\n                          :class=\"item3.icon\"\n                          v-if=\"item3.icon && item3.icon != ''\"\n                        ></i>\n                        <span>{{ item3.name }}</span>\n                      </template>\n                      <template >\n                        <div v-for=\"(item4, index4) in item3.children\" :key=\"index4\">\n                        <el-submenu\n                          :index=\"item4.id\"\n                          v-if=\"item4.children && item4.children.length > 0\"\n                          :key=\"index4\"\n                        >\n                          <template slot=\"title\">\n                            <i\n                              class=\"iconfont\"\n                              :class=\"item4.icon\"\n                              v-if=\"item4.icon && item4.icon != ''\"\n                            ></i>\n                            <span>{{ item4.name }}</span>\n                          </template>\n                        </el-submenu>\n                        <el-menu-item\n                          :index=\"item4.id\"\n                          v-if=\"!item4.children || item4.children.length == 0\"\n                          :key=\"index4\"\n                        >\n                          <i\n                            class=\"iconfont\"\n                            :class=\"item4.icon\"\n                            v-if=\"item4.icon && item4.icon != ''\"\n                          ></i>\n                          {{ item4.name }}\n                        </el-menu-item>\n                        </div>\n                      </template>\n                    </el-submenu>\n                    <el-menu-item\n                      :index=\"item3.id\"\n                      v-if=\"!item3.children || item3.children.length == 0\"\n                      :key=\"index3\"\n                    >\n                      <i\n                        class=\"iconfont\"\n                        :class=\"item3.icon\"\n                        v-if=\"item3.icon && item3.icon != ''\"\n                      ></i>\n                      {{ item3.name }}\n                    </el-menu-item>\n                    </div>\n                  </template>\n                </el-submenu>\n                <el-menu-item\n                  :index=\"item2.id\"\n                  v-if=\"!item2.children || item2.children.length == 0\"\n                  :key=\"index2\"\n                >\n                  <i\n                    class=\"iconfont\"\n                    :class=\"item2.icon\"\n                    v-if=\"item2.icon && item2.icon != ''\"\n                  ></i>\n                  {{ item2.name }}\n                </el-menu-item>\n                </div>\n              </template>\n            </el-submenu>\n            <el-menu-item\n              :index=\"item.id\"\n              v-if=\"!item.children || item.children.length == 0\"\n              :key=\"index\"\n            >\n              <i\n                class=\"iconfont\"\n                :class=\"item.icon\"\n                v-if=\"item.icon && item.icon != ''\"\n              ></i>\n              {{ item.name }}\n            </el-menu-item>\n            </div>\n          </template>\n        </el-menu>\n      </el-aside>\n      <el-main class=\"mscroll\">\n        <Devdoc :noselitem=\"this.$store.getters.apiid\" />\n      </el-main>\n    </el-container>\n  </div>\n</template>\n<script>\nimport '../../themes/iconfont/iconfont.css'\nimport Devdoc from '../../components/devdoc/Devdoc'\nexport default {\n  name: 'Docs',\n  components: { Devdoc },\n  data() {\n    return {\n      url: 'doc/docleft-z