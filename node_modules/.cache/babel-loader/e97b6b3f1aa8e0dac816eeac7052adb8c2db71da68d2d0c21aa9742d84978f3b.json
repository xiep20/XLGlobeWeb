{"ast":null,"code":"export default {\n  name: 'ZhihuiGuanwang',\n  props: {},\n  data: function data() {\n    return {\n      items_feature: [{\n        id: 1,\n        itemTitle: '管线运行监测',\n        itemText: '通过系统可对管线进行运行监测，管线漏损点定位、线路巡检、实时监测预警及应急处理管理等。'\n      }, {\n        id: 2,\n        itemTitle: '运行与维护',\n        itemText: '通过系统可对管线进行运行监测，管线漏损点定位、线路巡检、实时监测预警及应急处理管理等。'\n      }, {\n        id: 3,\n        itemTitle: '管线数据管理',\n        itemText: '提供海量、多源、异构数据的转换、编辑、质量检查、批量入库、参数自动化建模、动态增量更新、数据查询、统计输出、辅助决策分析等功能。'\n      }, {\n        id: 4,\n        itemTitle: '管线管理系统',\n        itemText: '提供二三维一体化的管线数据管理服务及系统功能应用服务，为管线档案管理、管线规划、设计、报建、审批、施工与竣工验收工作提供辅助设计与决策支持，缩短会签审批时间，提高工作效率与效能，为社会公众已发提供管线信息服务。'\n      }],\n      items_application: [{\n        id: 1,\n        imgSrc: require('../../../assets/images/application/zhgw_application1.png')\n      }, {\n        id: 2,\n        imgSrc: require('../../../assets/images/application/zhgw_application2.png')\n      }, {\n        id: 3,\n        imgSrc: require('../../../assets/images/application/zhgw_application3.png')\n      }]\n    };\n  },\n  watch: {},\n  mounted: function mounted() {},\n  methods: {}\n};","map":{"version":3,"names":["name","props","data","items_feature","id","itemTitle","itemText","items_application","imgSrc","require","watch","mounted","methods"],"sources":["src/views/application/item/Zhihuiguanwang.vue"],"sourcesContent":["<template>\r\n  <div class=\"body\">\r\n    <div class=\"wbk\">\r\n      <div class=\"part\" style=\"padding-bottom:20px\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>新型智慧城市</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"right_text\">\r\n          <p>\r\n            智慧管网综合管理系统基于SOA思想设计，采用C/S与B/S混合模式，以数据、管理、服务、应用相分离的架构原则，在保持灵活性和扩展的前提下，构建连接各相关政府部门和权属单位的城市地下管网数据管理服务中心，形成分布式应用和集中式管理的综合管线信息系统，实现地下管线信息数据的管理、共享、融合和数据交换。\r\n          </p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"wbk\">\r\n      <div class=\"mainImg\"></div>\r\n    </div>\r\n\r\n    <div class=\"gbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>系统特点</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div>\r\n        <ul class=\"right_ul\">\r\n          <li v-for=\"item in items_feature\" :key=\"item.id\">\r\n            <p>{{ item.itemTitle }}</p>\r\n            <p>{{ item.itemText }}</p>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"wbk\">\r\n      <div class=\"part\">\r\n        <div class=\"left_title\">\r\n          <div class=\"left_title_icon\"></div>\r\n          <div class=\"left_title_text\">\r\n            <p>应用案例</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"main_text\">\r\n        <p>\r\n          综合管廊智慧运维管理平台是将综合管廊内部的环境与设备监控系统、安全防范系统、通信系统、火灾自动报警系统、地理信息系统等的信息采集与联动控制有机地结合一起，放在监控中心的统一管理平台上，以实现对管廊内部设备的远程管理与控制。综合管理平台具有集中指挥调度、监控管理、数据管理、安全报警、应急联动和综合处理等功能，把综合管廊监控与报警各系统集成为一个相互关联和协调的综合系统，实现各系统统一管理、信息共\r\n          享及联动控制。\r\n        </p>\r\n      </div>\r\n      <div class=\"main_application\">\r\n        <ul>\r\n          <li v-for=\"item in items_application\" :key=\"item.id\">\r\n            <div\r\n              class=\"main_applicationImg\"\r\n              :style=\"'background-image: url(' + item.imgSrc + ')'\"\r\n            ></div>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'ZhihuiGuanwang',\r\n  props: {},\r\n  data() {\r\n    return {\r\n      items_feature: [\r\n        {\r\n          id: 1,\r\n          itemTitle: '管线运行监测',\r\n          itemText:\r\n            '通过系统可对管线进行运行监测，管线漏损点定位、线路巡检、实时监测预警及应急处理管理等。',\r\n        },\r\n        {\r\n          id: 2,\r\n          itemTitle: '运行与维护',\r\n          itemText:\r\n            '通过系统可对管线进行运行监测，管线漏损点定位、线路巡检、实时监测预警及应急处理管理等。',\r\n        },\r\n        {\r\n          id: 3,\r\n          itemTitle: '管线数据管理',\r\n          itemText:\r\n            '提供海量、多源、异构数据的转换、编辑、质量检查、批量入库、参数自动化建模、动态增量更新、数据查询、统计输出、辅助决策分析等功能。',\r\n        },\r\n        {\r\n          id: 4,\r\n          itemTitle: '管线管理系统',\r\n          itemText:\r\n            '提供二三维一体化的管线数据管理服务及系统功能应用服务，为管线档案管理、管线规划、设计、报建、审批、施工与竣工验收工作提供辅助设计与决策支持，缩短会签审批时间，提高工作效率与效能，为社会公众已发提供管线信息服务。',\r\n        },\r\n      ],\r\n      items_application: [\r\n        {\r\n          id: 1,\r\n          imgSrc: require('../../../assets/images/application/zhgw_application1.png'),\r\n        },\r\n        {\r\n          id: 2,\r\n          imgSrc: require('../../../assets/images/application/zhgw_application2.png'),\r\n        },\r\n        {\r\n          id: 3,\r\n          imgSrc: require('../../../assets/images/application/zhgw_application3.png'),\r\n        },\r\n      ],\r\n    }\r\n  },\r\n  watch: {},\r\n  mounted() {},\r\n  methods: {},\r\n}\r\n</script>\r\n<style lang=\"less\" scoped>\r\n.wbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #fff;\r\n}\r\n.gbk {\r\n  display: flex;\r\n  justify-content: center;\r\n  flex-wrap: wrap;\r\n  background: #f8f8f8;\r\n}\r\n.part {\r\n  display: flex;\r\n  width: 1200px;\r\n  padding: 80px 0;\r\n}\r\n.left_title {\r\n  display: flex;\r\n  margin-right: 90px;\r\n}\r\n.left_title_icon {\r\n  width: 6px;\r\n  height: 36px;\r\n  background: linear-gradient(0deg, #09bbfe 0%, #5a42ec 100%);\r\n  margin-top: 8px;\r\n  margin-right: 10px;\r\n}\r\n.left_title_text {\r\n  width: 230px;\r\n  font-size: 38px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: bold;\r\n  color: #333333;\r\n  line-height: 50px;\r\n}\r\n.right_text {\r\n  width: 870px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 300;\r\n  color: #333333;\r\n  line-height: 30px;\r\n}\r\n.mainImg {\r\n  width: 1200px;\r\n  height: 808px;\r\n  margin-bottom: 80px;\r\n  background: url('~@/assets/images/application/zhgw_main.png') no-repeat;\r\n  background-size: 100%;\r\n}\r\n.right_ul {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  width: 1200px;\r\n  margin-top: -40px;\r\n  list-style: none;\r\n  padding-bottom: 80px;\r\n  li {\r\n    width: 520px;\r\n    height: 140px;\r\n    padding: 40px;\r\n    p:nth-child(1) {\r\n      position: relative;\r\n      top: 120px;\r\n      bottom: 0px;\r\n      margin: 0 auto;\r\n      font-size: 18px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: bold;\r\n    }\r\n    p:nth-child(2) {\r\n      font-size: 14px;\r\n      font-family: Microsoft YaHei;\r\n      font-weight: 400;\r\n    }\r\n  }\r\n  li:nth-child(2) {\r\n    color: #333333;\r\n    background: #ffffff;\r\n  }\r\n  li:nth-child(3) {\r\n    color: #333333;\r\n    background: #ffffff;\r\n  }\r\n  li:nth-child(1) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n  li:nth-child(4) {\r\n    color: #ffffff;\r\n    background: linear-gradient(0deg, #102650 0%, #040d1d 100%);\r\n  }\r\n}\r\n.main_text {\r\n  width: 1198px;\r\n  margin-top: -40px;\r\n  font-size: 14px;\r\n  font-family: Microsoft YaHei;\r\n  font-weight: 400;\r\n  color: #666666;\r\n  line-height: 28px;\r\n}\r\n.main_application {\r\n  width: 1198px;\r\n  margin-top: 20px;\r\n  margin-bottom: 81px;\r\n  ul {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    list-style: none;\r\n    margin-top: 20px;\r\n    li:nth-child(1) {\r\n      .main_applicationImg {\r\n        height: 295px;\r\n        width: 580px;\r\n        margin-right: 38px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(2) {\r\n      .main_applicationImg {\r\n        height: 295px;\r\n        width: 580px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n    li:nth-child(3) {\r\n      .main_applicationImg {\r\n        margin-top: 40px;\r\n        height: 390px;\r\n        width: 1200px;\r\n        background-size: 100%;\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAqEA;EACAA,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,aAAA,GACA;QACAC,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,GACA;QACAF,EAAA;QACAC,SAAA;QACAC,QAAA,EACA;MACA,EACA;MACAC,iBAAA,GACA;QACAH,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA,GACA;QACAL,EAAA;QACAI,MAAA,EAAAC,OAAA;MACA;IAEA;EACA;EACAC,KAAA;EACAC,OAAA,WAAAA,QAAA;EACAC,OAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}